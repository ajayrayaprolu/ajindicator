//=====================================
// src/components/AlertsPanel.tsx
//=====================================
//
// Same layout convention as WatchlistPanel (fills its container,
// tabs on top, scrollable list below). Mount it exactly where
// WatchlistPanel is mounted.
//=====================================

import { useEffect, useState } from "react";
import { AlertStore, type PriceAlert } from "../store/AlertStore";
import { TelegramNotifier } from "../services/TelegramNotifier";

function fmtTime(ts?: number): string {
    if (!ts) return "";
    return new Date(ts).toLocaleString("en-IN", { hour12: false });
}

export default function AlertsPanel() {

    const [tab, setTab] = useState<"active" | "triggered">(
        AlertStore.getUnreadCount() > 0 ? "triggered" : "active"
    );
    const [tick, forceRender] = useState(0);
    const [tgOn, setTgOn] = useState(TelegramNotifier.isEnabled());
    const [tgStatus, setTgStatus] = useState("");

    useEffect(() => {
        return AlertStore.subscribe(() => forceRender(n => n + 1));
    }, []);

    // Viewing the Triggered tab marks everything read (clears the badge).
    useEffect(() => {
        if (tab === "triggered") {
            AlertStore.markAllRead();
        }
    }, [tab, tick]);

    const active: PriceAlert[] = AlertStore.getActive();
    const triggered: PriceAlert[] = AlertStore.getTriggered();

    const tabStyle = (selected: boolean) => ({
        flex: 1,
        padding: "8px 4px",
        background: selected ? "#1e3a24" : "transparent",
        color: selected ? "#8ee6a1" : "#999",
        border: "none",
        borderBottom: selected ? "2px solid #4caf50" : "2px solid transparent",
        fontSize: 12,
        fontWeight: 700,
        cursor: "pointer"
    } as const);

    return (
        <div style={{ display: "flex", flexDirection: "column", height: "100%", color: "#ddd" }}>

            <div
                style={{
                    display: "flex", alignItems: "center", gap: 8,
                    padding: "6px 10px", borderBottom: "1px solid #333",
                    flexShrink: 0, fontSize: 11
                }}
            >
                <label style={{ display: "flex", alignItems: "center", gap: 6, cursor: "pointer", color: "#bbb" }}>
                    <input
                        type="checkbox"
                        checked={tgOn}
                        onChange={(e) => {
                            TelegramNotifier.setEnabled(e.target.checked);
                            setTgOn(e.target.checked);
                        }}
                    />
                    Telegram trade alerts
                </label>
                <button
                    onClick={async () => {
                        setTgStatus("sending...");
                        setTgStatus(await TelegramNotifier.testDetailed());
                    }}
                    style={{
                        background: "transparent", border: "1px solid #333", color: "#999",
                        borderRadius: 4, cursor: "pointer", fontSize: 11, padding: "2px 8px"
                    }}
                >
                    Test
                </button>
                <span style={{ color: "#888" }}>{tgStatus}</span>
            </div>
            <div style={{ display: "flex", borderBottom: "1px solid #333", flexShrink: 0 }}>
                <button onClick={() => setTab("active")} style={tabStyle(tab === "active")}>
                    Active ({active.length})
                </button>
                <button onClick={() => setTab("triggered")} style={tabStyle(tab === "triggered")}>
                    Triggered ({triggered.length})
                </button>
            </div>

            <div style={{ flex: 1, overflowY: "auto" }}>

                {tab === "active" && active.length === 0 && (
                    <div style={{ padding: 14, color: "#666", fontSize: 12 }}>
                        No active alerts. Hover a chart, then click the "+ Alert" button that appears next to the price.
                    </div>
                )}

                {tab === "active" && active.map(a => (
                    <div
                        key={a.id}
                        style={{
                            display: "flex", justifyContent: "space-between", alignItems: "center",
                            padding: "8px 10px", borderBottom: "1px solid #1e1e1e"
                        }}
                    >
                        <div>
                            <div style={{ fontSize: 13, fontWeight: 700, color: "#fff" }}>
                                {a.symbol} {a.direction === "above" ? "\u2265" : "\u2264"} {a.price}
                            </div>
                            <div style={{ fontSize: 10, color: "#888" }}>
                                {a.timeframe} • {fmtTime(a.createdAt)}
                            </div>
                        </div>
                        <button
                            onClick={() => AlertStore.remove(a.id)}
                            title="Delete alert"
                            style={{
                                background: "transparent", border: "none", color: "#666",
                                cursor: "pointer", fontSize: 14, padding: "0 4px"
                            }}
                        >
                            ✕
                        </button>
                    </div>
                ))}

                {tab === "triggered" && triggered.length === 0 && (
                    <div style={{ padding: 14, color: "#666", fontSize: 12 }}>
                        No triggered alerts yet.
                    </div>
                )}

                {tab === "triggered" && triggered.length > 0 && (
                    <div style={{ padding: "6px 10px", borderBottom: "1px solid #1e1e1e", textAlign: "right" }}>
                        <button
                            onClick={() => AlertStore.clearTriggered()}
                            style={{
                                background: "transparent", border: "1px solid #333", color: "#999",
                                borderRadius: 4, cursor: "pointer", fontSize: 11, padding: "2px 8px"
                            }}
                        >
                            Clear all
                        </button>
                    </div>
                )}

                {tab === "triggered" && triggered.map(a => (
                    <div
                        key={a.id}
                        style={{ padding: "8px 10px", borderBottom: "1px solid #1e1e1e" }}
                    >
                        <div style={{ fontSize: 13, fontWeight: 700, color: "#ffb300" }}>
                            {"\uD83D\uDD14"} {a.message}
                        </div>
                        <div style={{ fontSize: 10, color: "#888" }}>
                            {a.timeframe} • {fmtTime(a.triggeredAt)}
                        </div>
                    </div>
                ))}

            </div>
        </div>
    );
}