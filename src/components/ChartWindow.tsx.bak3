//======================================================
// ALICE BLUE FRESHNESS
//======================================================

interface AliceBlueFreshness {
    hasCache: boolean;
    cachedAt: string | null;
    ageMs: number | null;
    count: number;
}

function formatFreshnessAge(ageMs: number | null): string {

    if (ageMs === null || !Number.isFinite(ageMs) || ageMs < 0) {
        return "just now";
    }

    const seconds = Math.floor(ageMs / 1000);

    if (seconds < 60) {
        return "just now";
    }

    const minutes = Math.floor(seconds / 60);

    if (minutes < 60) {
        return `${minutes}m ago`;
    }

    const hours = Math.floor(minutes / 60);

    if (hours < 24) {
        return `${hours}h ago`;
    }

    const days = Math.floor(hours / 24);

    return `${days}d ago`;
}

//======================================================
// BINANCE AUTOMATIC MARKET RESOLVER
//======================================================

type BinanceMarket = "spot" | "futures";

interface BinanceResolvedInstrument {

    requestedSymbol: string;

    binanceSymbol: string;

    market: BinanceMarket;

}

interface BinanceExchangeInfoSymbol {

    symbol?: string;

    status?: string;

}

interface BinanceExchangeInfo {

    symbols?: BinanceExchangeInfoSymbol[];

}

// Module-level cache.
// exchangeInfo is relatively static and must NOT be downloaded
// on every chart refresh / candle update.

let binanceInstrumentCache:
    | {
        spot: Set<string>;
        futures: Set<string>;
        loadedAt: number;
    }
    | null = null;

let binanceResolverPromise:
    | Promise<{
        spot: Set<string>;
        futures: Set<string>;
    }>
    | null = null;

const BINANCE_EXCHANGE_INFO_TTL =
    15 * 60 * 1000;

function normalizeBinanceSymbol(
    value: unknown
): string {

    return String(value ?? "")
        .trim()
        .toUpperCase()
        .replace(/[^A-Z0-9]/g, "");

}

function getBinanceCandidates(
    requestedSymbol: string
): string[] {

    const normalized =
        normalizeBinanceSymbol(
            requestedSymbol
        );

    if (!normalized) {
        return [];
    }

    const candidates =
        new Set<string>();

    // Exact normalized symbol always gets priority.
    candidates.add(
        normalized
    );

    // Generic USD -> USDT candidate.
    //
    // This handles instruments such as:
    // XAUUSD -> XAUUSDT
    // BTCUSD -> BTCUSDT
    // ETHUSD -> ETHUSDT
    //
    // No symbol-specific hardcoding is required.
    if (
        normalized.endsWith("USD") &&
        !normalized.endsWith("USDT")
    ) {

        candidates.add(
            `${normalized.slice(0, -3)}USDT`
        );

    }

    return Array.from(
        candidates
    );

}

async function loadBinanceExchangeInfo(): Promise<{
    spot: Set<string>;
    futures: Set<string>;
}> {

    const now =
        Date.now();

    if (
        binanceInstrumentCache &&
        now - binanceInstrumentCache.loadedAt <
            BINANCE_EXCHANGE_INFO_TTL
    ) {

        return {
            spot:
                binanceInstrumentCache.spot,
            futures:
                binanceInstrumentCache.futures
        };

    }

    if (binanceResolverPromise) {
        return binanceResolverPromise;
    }

    binanceResolverPromise =
        (async () => {

            const [
                spotResponse,
                futuresResponse
            ] = await Promise.all([

                fetch(
                    "https://api.binance.com/api/v3/exchangeInfo"
                ),

                fetch(
                    "https://fapi.binance.com/fapi/v1/exchangeInfo"
                )

            ]);

            if (
                !spotResponse.ok
            ) {

                throw new Error(
                    `Binance Spot exchangeInfo failed: ${spotResponse.status}`
                );

            }

            if (
                !futuresResponse.ok
            ) {

                throw new Error(
                    `Binance Futures exchangeInfo failed: ${futuresResponse.status}`
                );

            }

            const [
                spotData,
                futuresData
            ] =
                await Promise.all([
                    spotResponse.json() as Promise<BinanceExchangeInfo>,
                    futuresResponse.json() as Promise<BinanceExchangeInfo>
                ]);

            const spot =
                new Set<string>();

            const futures =
                new Set<string>();

            for (
                const item
                of spotData?.symbols ?? []
            ) {

                const symbolName =
                    normalizeBinanceSymbol(
                        item?.symbol
                    );

                if (
                    symbolName &&
                    (
                        !item.status ||
                        item.status === "TRADING"
                    )
                ) {

                    spot.add(
                        symbolName
                    );

                }

            }

            for (
                const item
                of futuresData?.symbols ?? []
            ) {

                const symbolName =
                    normalizeBinanceSymbol(
                        item?.symbol
                    );

                if (
                    symbolName &&
                    (
                        !item.status ||
                        item.status === "TRADING"
                    )
                ) {

                    futures.add(
                        symbolName
                    );

                }

            }

            binanceInstrumentCache = {

                spot,

                futures,

                loadedAt:
                    Date.now()

            };

            return {
                spot,
                futures
            };

        })()
        .finally(() => {

            binanceResolverPromise =
                null;

        });

    return binanceResolverPromise;

}

async function resolveBinanceInstrument(
    requestedSymbol: string
): Promise<BinanceResolvedInstrument> {

    const candidates =
        getBinanceCandidates(
            requestedSymbol
        );

    if (!candidates.length) {

        throw new Error(
            "Invalid Binance symbol."
        );

    }

    const catalogue =
        await loadBinanceExchangeInfo();

    //--------------------------------------------------
    // SPOT FIRST
    //
    // Preserves the existing Binance behaviour for
    // BTCUSDT / ETHUSDT / SOLUSDT.
    //--------------------------------------------------

    for (
        const candidate
        of candidates
    ) {

        if (
            catalogue.spot.has(
                candidate
            )
        ) {

            return {

                requestedSymbol,

                binanceSymbol:
                    candidate,

                market:
                    "spot"

            };

        }

    }

    //--------------------------------------------------
    // FUTURES SECOND
    //
    // Automatically catches instruments such as
    // XAUUSDT which are not Binance Spot symbols.
    //--------------------------------------------------

    for (
        const candidate
        of candidates
    ) {

        if (
            catalogue.futures.has(
                candidate
            )
        ) {

            return {

                requestedSymbol,

                binanceSymbol:
                    candidate,

                market:
                    "futures"

            };

        }

    }

    throw new Error(
        `Binance instrument not found in Spot or Futures: ${requestedSymbol}`
    );

}

//======================================================
// OPTION SYMBOL CANONICALIZATION
//======================================================

const OPTION_MONTHS: Record<string, string> = {
    "01": "JAN",
    "02": "FEB",
    "03": "MAR",
    "04": "APR",
    "05": "MAY",
    "06": "JUN",
    "07": "JUL",
    "08": "AUG",
    "09": "SEP",
    "10": "OCT",
    "11": "NOV",
    "12": "DEC"
};

function normalizeOptionExpiry(
    value: unknown
): string {

    const raw =
        String(value ?? "")
            .trim()
            .toUpperCase();

    if (!raw) {
        return "";
    }

    // 29SEP / 29 SEP / 29-SEP
    const compact =
        raw.match(
            /^(\d{1,2})[\s-]*([A-Z]{3})$/
        );

    if (compact) {
        return `${Number(compact[1])}${compact[2]}`;
    }

    // MM/DD/YYYY [HH:MM]
    const usDate =
        raw.match(
            /^(\d{1,2})\/(\d{1,2})\/(\d{4})(?:\s+\d{1,2}:\d{2}(?::\d{2})?)?$/
        );

    if (usDate) {
        const month =
            OPTION_MONTHS[
                String(usDate[1]).padStart(2, "0")
            ];

        if (month) {
            return `${Number(usDate[2])}${month}`;
        }
    }

    // ISO date/time
    const isoDate =
        raw.match(
            /^(\d{4})-(\d{1,2})-(\d{1,2})/
        );

    if (isoDate) {
        const month =
            OPTION_MONTHS[
                String(isoDate[2]).padStart(2, "0")
            ];

        if (month) {
            return `${Number(isoDate[3])}${month}`;
        }
    }

    // DD/MM/YYYY
    const indianDate =
        raw.match(
            /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/
        );

    if (indianDate) {
        const month =
            OPTION_MONTHS[
                String(indianDate[2]).padStart(2, "0")
            ];

        if (month) {
            return `${Number(indianDate[1])}${month}`;
        }
    }

    return raw
        .replace(/[\s-]+/g, "")
        .replace(/\d{4}$/, "");
}

function parseOptionSymbol(
    value: unknown
): {
    underlying: string;
    expiry: string;
    strike: number;
    optionType: string;
    symbol: string;
} | null {

    const raw =
        String(value ?? "")
            .trim()
            .toUpperCase()
            .replace(/\s+/g, " ");

    if (!raw) {
        return null;
    }

    const match =
        raw.match(
            /^(.*?)\s+(.+?)\s+(\d+(?:\.\d+)?)\s*(CE|PE)$/
        );

    if (!match) {
        return null;
    }

    const parsedUnderlying =
        match[1].trim();

    const parsedExpiry =
        normalizeOptionExpiry(
            match[2]
        );

    const parsedStrike =
        Number(match[3]);

    const parsedOptionType =
        match[4].toUpperCase();

    if (
        !parsedUnderlying ||
        !parsedExpiry ||
        !Number.isFinite(parsedStrike) ||
        !/^(CE|PE)$/.test(parsedOptionType)
    ) {
        return null;
    }

    const canonicalSymbol =
        `${parsedUnderlying} ${parsedExpiry} ${parsedStrike} ${parsedOptionType}`;

    return {
        underlying:
            parsedUnderlying,

        expiry:
            parsedExpiry,

        strike:
            parsedStrike,

        optionType:
            parsedOptionType,

        symbol:
            canonicalSymbol
    };
}

function canonicalizeOptionData(
    symbolValue: unknown,
    underlyingValue: unknown,
    expiryValue: unknown,
    strikeValue: unknown,
    optionTypeValue: unknown
): {
    symbol: string;
    underlying: string;
    expiry: string;
    strike: number;
    optionType: string;
    isOptionChart: boolean;
} {

    const parsed =
        parseOptionSymbol(
            symbolValue
        );

    const normalizedUnderlying =
        String(
            underlyingValue ??
            parsed?.underlying ??
            ""
        )
            .trim()
            .toUpperCase();

    const normalizedExpiry =
        normalizeOptionExpiry(
            expiryValue ??
            parsed?.expiry ??
            ""
        );

    const numericStrike =
        Number.isFinite(
            Number(strikeValue)
        )
            ? Number(strikeValue)
            : (
                parsed?.strike ??
                0
            );

    const normalizedOptionType =
        String(
            optionTypeValue ??
            parsed?.optionType ??
            ""
        )
            .trim()
            .toUpperCase();

    const isOptionChart =
        Boolean(
            normalizedUnderlying &&
            normalizedExpiry &&
            Number.isFinite(numericStrike) &&
            numericStrike > 0 &&
            /^(CE|PE)$/.test(
                normalizedOptionType
            )
        );

    const canonicalSymbol =
        isOptionChart
            ? `${normalizedUnderlying} ${normalizedExpiry} ${numericStrike} ${normalizedOptionType}`
            : String(symbolValue ?? "").trim();

    return {
        symbol:
            canonicalSymbol,

        underlying:
            normalizedUnderlying,

        expiry:
            normalizedExpiry,

        strike:
            numericStrike,

        optionType:
            normalizedOptionType,

        isOptionChart
    };
}

//======================================================
// COMPONENT
//======================================================

export default function ChartWindow({
    chartId,
    symbol,
    displayName,
    yahooSymbol,
    datasource,
    timeframe,
    indicators,
    exchange,
    feedSource,
    underlying,
    expiry,
    strike,
    optionType,
    isActive,
    onActivate,
    candleColors,
    onCandleColorsChange,
}: Props) {
	
	//--------------------------------------------------
    // CANONICAL OPTION IDENTITY
    //--------------------------------------------------

    const optionIdentity =
        useMemo(
            () =>
                canonicalizeOptionData(
                    symbol,
                    underlying,
                    expiry,
                    strike,
                    optionType
                ),
            [
                symbol,
                underlying,
                expiry,
                strike,
                optionType
            ]
        );

    const chartSymbol =
        optionIdentity.symbol;

    //--------------------------------------------------
    // CANDLES
    //--------------------------------------------------

    const [
        candles,
        setCandles
    ] = useState<Candle[]>([]);

	const [
		feedError,
		setFeedError
	] = useState<string | null>(null);

	//--------------------------------------------------
	// ALICE BLUE STORE FRESHNESS
	//
	// Populated from getHistory()'s freshness field.
	// This drives the "last synced Xm ago" badge instead
	// of blocking the chart on a hard error whenever the
	// store has anything at all.
	//--------------------------------------------------

	const [
		aliceBlueFreshness,
		setAliceBlueFreshness
	] = useState<AliceBlueFreshness | null>(null);

	const [
		zerodhaLoggedIn,
		setZerodhaLoggedIn
	] = useState(false);
	
	const [
		checkingSession,
		setCheckingSession
	] = useState(false);
	
	//--------------------------------------------------
	// ALICE BLUE AUTH STATE
	//--------------------------------------------------
	
	const [
		aliceBlueLoggedIn,
		setAliceBlueLoggedIn
	] = useState(false);
	
	const [
		aliceBlueStatus,
		setAliceBlueStatus
	] = useState("checking");
	
	const [
		aliceBlueMessage,
		setAliceBlueMessage
	] = useState("");
	
	//--------------------------------------------------
	// FYERS AUTH STATUS
	//--------------------------------------------------
	
	const [
		fyersLoggedIn,
		setFyersLoggedIn
	] = useState(false);
	
	const [
		fyersStatus,
		setFyersStatus
	] = useState("login_required");
	
	const [
		fyersMessage,
		setFyersMessage
	] = useState("");
	
	//--------------------------------------------------
	// ZERODHA AUTH STATUS
	//--------------------------------------------------
	
	const [
		zerodhaStatus,
		setZerodhaStatus
	] = useState("checking");
	
	const [
		zerodhaMessage,
		setZerodhaMessage
	] = useState("");
	
    //--------------------------------------------------
    // RUNTIME
    //--------------------------------------------------

    const [
        runtimeResult,
        setRuntimeResult
    ] = useState<RuntimeResult | null>(
        null
    );

    //--------------------------------------------------
    // HOST
    //--------------------------------------------------

    const [
        hostResult,
        setHostResult
    ] = useState<any>(
        null
    );

    //--------------------------------------------------
    // RUNTIME ENGINE
    //--------------------------------------------------

    const runtimeEngineRef =
        useRef(

            new RuntimeEngine()

        );

    //--------------------------------------------------
    // BINANCE RESOLVED INSTRUMENT
    //
    // Keeps the same resolved symbol/market for both
    // historical REST data and live WebSocket data.
    //--------------------------------------------------

    const binanceResolvedRef =
        useRef<BinanceResolvedInstrument | null>(
            null
        );

    //--------------------------------------------------
    // BUILD RUNTIME CONTEXT
    //--------------------------------------------------

    const runtimeContext =
        useMemo<RuntimeContext | null>(() => {

            if (
                candles.length < 2
            ) {
                return null;
            }

            const current =
                candles[
                    candles.length - 1
                ];

            const previous =
                candles[
                    candles.length - 2
                ];

            return {

                chartId,

                // ALWAYS use canonical option symbol.
                symbol:
                    chartSymbol,

                timeframe,
                datasource,
                candles,
                current,
                previous,

                barIndex:
                    candles.length - 1,

                timestamp:
                    current.time,

                open:
                    current.open,

                high:
                    current.high,

                low:
                    current.low,

                close:
                    current.close,

                volume:
                    current.volume ?? 0,

                tradeDirection: 0,

                entryPrice:
                    current.close,

                stopLoss:
                    current.close,

                slPrice:
                    current.close,

                takeProfit1:
                    current.close,

                takeProfit2:
                    current.close,

                takeProfit3:
                    current.close,

                tp1:
                    current.close,

                tp2:
                    current.close,

                tp3:
                    current.close,

                currentPrice:
                    current.close,

                positionSize: 0,
                positionOpen: false,
                inPosition: false,

                atr: 0,
                riskATR: 0,
                slBuffer: 0,

                tp1RR: 1,
                tp2RR: 2,
                tp3RR: 3,

                //--------------------------------------------------
                // OPTION STATE
                //--------------------------------------------------

                isOptionsMode:
                    optionIdentity.isOptionChart,

                isOptionChart:
                    optionIdentity.isOptionChart,

                isMirrorOptionChart:
                    false,

                underlying:
                    optionIdentity.underlying,

                expiry:
                    optionIdentity.expiry,

                strike:
                    optionIdentity.strike,

                strikeStep:
                    50,

                currentOptionType:
                    optionIdentity.optionType,

                optionSymbol:
                    optionIdentity.isOptionChart
                        ? chartSymbol
                        : "",

                optionUnderlying:
                    optionIdentity.underlying,

                optionExpiry:
                    optionIdentity.expiry,

                optionType:
                    optionIdentity.optionType,

                optionStrike:
                    optionIdentity.strike,

                greekExecOk:
                    false,

                greekOptionMode:
                    optionIdentity.isOptionChart,

                enableAITradeSafety:
                    true,

                enableAISMCMode:
                    true,

                tradeLifecycleLocked:
                    false,

                useVWAP:
                    true,

                useCVD:
                    true,

                sessionName:
                    "",

                sessionOpen:
                    true,

                sessionHigh:
                    current.high,

                sessionLow:
                    current.low,

                dayHigh:
                    current.high,

                dayLow:
                    current.low,

                marketOpen:
                    true,

                marketClose:
                    false,

                exchange:
                    exchange || "",

                broker:
                    feedSource ||
                    datasource ||
                    "",

                accountId:
                    "",

                currency:
                    "INR",

                tickSize:
                    0.05,

                lotSize:
                    1,

                pointValue:
                    1,

                pricePrecision:
                    2,

                quantityPrecision:
                    0,

                orderId:
                    "",

                orderActive:
                    false,

                orderFilled:
                    false,

                orderCancelled:
                    false,

                positionSide:
                    0,

                unrealizedPnL:
                    0,

                realizedPnL:
                    0,

                state:
                    0 as any,

                engineState:
                    0 as any,

                metadata:
                    {},

                tags:
                    []

            };

        }, [
            chartId,
            candles,
            chartSymbol,
            symbol,
            timeframe,
            datasource,
            underlying,
            expiry,
            strike,
            optionType,
            exchange,
            feedSource,
            optionIdentity
        ]);
		
	//--------------------------------------------------
	// BROKER AUTHENTICATION STATUS
	//--------------------------------------------------
	
	useEffect(() => {
	
		//------------------------------------------------
		// FYERS
		//------------------------------------------------
	
		if (
			(datasource as string) === "Fyers"
		) {
			setZerodhaLoggedIn(false);
			setFyersLoggedIn(false);
			setFyersStatus(
				"login_required"
			);
			setFyersMessage(
				"Login to Fyers to enable the Fyers market-data feed."
			);
			return;
		}
	
		//------------------------------------------------
		// NON-ZERODHA DATASOURCES
		//------------------------------------------------
	
		if (
			datasource !== "Zerodha" &&
			datasource !== "zerodha"
		) {
	
			setZerodhaLoggedIn(false);
	
			return;
		}
	
		//------------------------------------------------
		// ZERODHA
		//------------------------------------------------
	
		async function checkZerodhaSession() {
	
			setCheckingSession(true);
	
			try {
	
				const response =
					await fetch(
						"https://localhost:3001/api/zerodha/session"
					);
	
				const session =
					await response.json();
	
				setZerodhaLoggedIn(
					session.loggedIn === true
				);
	
				setZerodhaStatus(
					session.status ??
					"login_required"
				);
	
				setZerodhaMessage(
					session.message ??
					""
				);
	
			}
			catch {
	
				setZerodhaLoggedIn(false);
	
				setZerodhaStatus(
					"server_unavailable"
				);
	
				setZerodhaMessage(
					"Unable to contact Zerodha service."
				);
	
			}
			finally {
	
				setCheckingSession(false);
	
			}
	
		}
	
		checkZerodhaSession();
	
	}, [
		datasource
	]);
	
	//--------------------------------------------------
	// FYERS SESSION STATUS
	//--------------------------------------------------
	
	useEffect(() => {
	
		if (
			datasource !== "Fyers"
		) {
			return;
		}
	
		let mounted = true;
		async function checkFyersSession() {
	
			setFyersStatus(
				"checking"
			);
	
			setFyersMessage(
				"Checking Fyers session..."
			);
	
			try {
	
				const response =
					await fetch(
						"https://localhost:3001/api/fyers/status"
					);
	
				if (
					!response.ok
				) {
	
					throw new Error(
						`Fyers status request failed: ${response.status}`
					);
	
				}
	
				const status =
					await response.json();
	
				if (!mounted) {
					return;
				}
	
				const loggedIn =
					status?.loggedIn === true;
	
				setFyersLoggedIn(
					loggedIn
				);
	
				setFyersStatus(
					loggedIn
						? "connected"
						: "login_required"
				);
	
				setFyersMessage(
					loggedIn
						? "Fyers authentication is active."
						: "Login to Fyers to enable the Fyers market-data feed."
				);
	
			}
			catch (error: any) {
	
				if (!mounted) {
					return;
				}
	
				setFyersLoggedIn(
					false
				);
	
				setFyersStatus(
					"server_unavailable"
				);
	
				setFyersMessage(
					error?.message ??
					"Unable to contact Fyers service."
				);
	
			}
	
		}
	
		checkFyersSession();
	
		return () => {
	
			mounted = false;
	
		};
	
	}, [
		datasource
	]);

	//--------------------------------------------------
	// ALICE BLUE SESSION STATUS
	//--------------------------------------------------
	
	useEffect(() => {
	
		if (
			datasource !== "AliceBlue" &&
			datasource !== "aliceblue"
		) {
			return;
		}

		let mounted = true;
		async function checkAliceBlueSession() {
	
			setAliceBlueStatus(
				"checking"
			);
	
			setAliceBlueMessage(
				"Checking Alice Blue session..."
			);
	
			try {
	
				const response =
					await fetch(
						"https://localhost:3001/api/aliceblue/status"
					);
	
				if (
					!response.ok
				) {
	
					throw new Error(
						`Alice Blue status request failed: ${response.status}`
					);
	
				}
	
				const status =
					await response.json();
	
				if (
					!mounted
				) {
	
					return;
	
				}
	
				const loggedIn =
					status?.loggedIn === true;
	
				setAliceBlueLoggedIn(
					loggedIn
				);
	
				setAliceBlueStatus(
					loggedIn
						? "connected"
						: "login_required"
				);
	
				setAliceBlueMessage(
	
					loggedIn
	
						? "Alice Blue authentication is active."
	
						: "Login to Alice Blue to enable the market-data feed."
	
				);
	
			}
	
			catch (error: unknown) {
			
				if (!mounted) {
					return;
				}
			
				setAliceBlueLoggedIn(false);
			
				setAliceBlueStatus(
					"server_unavailable"
				);
			
				setAliceBlueMessage(
					error instanceof Error
						? error.message
						: "Unable to contact Alice Blue service."
				);
			}
	
		}
	
		checkAliceBlueSession();
	
		return () => {
	
			mounted = false;
	
		};
	
	}, [
		datasource
	]);

//--------------------------------------------------
// MARKET DATA HISTORY
//
// Each datasource has its own historical-data path.
// Do not allow broker feeds to fall through into Yahoo.
//--------------------------------------------------
useEffect(() => {

    let mounted = true;

    //--------------------------------------------------
    // Reset Binance resolution whenever the selected
    // symbol changes.
    //--------------------------------------------------

    if (
        String(datasource ?? "")
            .trim()
            .toLowerCase() === "binance"
    ) {

        binanceResolvedRef.current =
            null;

    }

    // ZERODHA
    //--------------------------------------------------

    if (
        datasource === "zerodha" ||
        datasource === "Zerodha"
    ) {

        async function loadZerodhaHistory() {

            if (!zerodhaLoggedIn) {

                console.log(
                    "[ChartWindow] ZERODHA history skipped - not logged in."
                );

                setCandles([]);
                setFeedError(null);

                return;

            }

            if (!symbol) {

                console.log(
                    "[ChartWindow] ZERODHA history skipped - no symbol."
                );

                return;

            }

            try {

                const response =
                    await fetch(
                        `/api/zerodha/history/${encodeURIComponent(
                            symbol
                        )}?timeframe=${encodeURIComponent(
                            timeframe
                        )}`
                    );

                if (!response.ok) {

                    const errorText =
                        await response.text();

                    throw new Error(
                        `ZERODHA history HTTP ${response.status}: ${errorText}`
                    );

                }

                const data =
                    await response.json();

                const history =
                    Array.isArray(data?.candles)
                        ? data.candles
                        : Array.isArray(data)
                            ? data
                            : [];

                console.log(
                    "[ChartWindow] ZERODHA history response",
                    {
                        requestedSymbol: symbol,
                        timeframe,
                        count: history.length,
                        first: history[0],
                        last:
                            history[
                                history.length - 1
                            ]
                    }
                );

                if (!mounted) {
                    return;
                }

                if (history.length === 0) {

                    console.warn(
                        "[ChartWindow] ZERODHA returned zero candles."
                    );

                    setCandles([]);
                    setFeedError(
                        "ZERODHA returned no historical candles."
                    );

                    return;

                }

                setCandles(history);

                setFeedError(null);

                console.log(
                    "[ChartWindow] ZERODHA candles pushed to ChartEngine",
                    {
                        count: history.length
                    }
                );

            }
            catch (error) {

                if (!mounted) {
                    return;
                }

                console.error(
                    "[ChartWindow] ZERODHA history FAILED",
                    error
                );

                setCandles([]);

                setFeedError(
                    error instanceof Error
                        ? error.message
                        : "Unable to load ZERODHA historical data."
                );

            }

        }

        loadZerodhaHistory();

        return () => {

            mounted = false;

        };

    }

    //--------------------------------------------------
    // FYERS HISTORY
    //
    // Fyers authentication and historical data are
    // separate operations.
    //--------------------------------------------------

    async function loadFyersHistory() {

        if (datasource !== "Fyers") {
            return;
        }

        if (!fyersLoggedIn) {

            console.log(
                "[ChartWindow] FYERS history skipped - not logged in."
            );

            return;

        }

        if (!symbol) {

            console.log(
                "[ChartWindow] FYERS history skipped - no symbol."
            );

            return;

        }

        //--------------------------------------------------
        // FYERS SYMBOL
        //
        // For option contracts, resolve the canonical
        // identity (underlying + expiry + strike + type)
        // to the real broker symbol via the server-side
        // OptionContractResolver before requesting history.
        // Non-option symbols pass through unchanged.
        //--------------------------------------------------

        try {

		let fyersSymbol =
			String(symbol ?? "")
				.trim()
				.toUpperCase()
				.replace(/\s+/g, "");

		if (
			underlying &&
			expiry &&
			Number.isFinite(strike) &&
			optionType &&
			/^(CE|PE)$/i.test(optionType)
		) {

			const resolveResponse = await fetch(
				`/api/fyers/options/resolve?underlying=${encodeURIComponent(
					underlying!
				)}&expiry=${encodeURIComponent(
					expiry!
				)}&strike=${encodeURIComponent(
					String(strike)
				)}&type=${encodeURIComponent(
					optionType!.toUpperCase()
				)}`
			);

			if (!resolveResponse.ok) {
				throw new Error(
					`FYERS option resolution failed: ${resolveResponse.status}`
				);
			}

			const resolved = await resolveResponse.json();

			const nativeSymbol =
				resolved?.symbolTicker ??
				resolved?.symbol ??
				resolved?.result?.symbolTicker ??
				resolved?.result?.symbol ??
				resolved?.contract?.symbolTicker ??
				resolved?.contract?.symbol;

			if (!nativeSymbol) {
				throw new Error(
					"FYERS option resolution returned no native broker symbol."
				);
			}

			fyersSymbol = String(nativeSymbol)
				.trim()
				.toUpperCase();

		}

        const response =
            await fetch(
                `/api/fyers/history?symbol=${encodeURIComponent(
                    fyersSymbol
                )}&timeframe=${encodeURIComponent(
                    timeframe
                )}`
            );

        if (!response.ok) {

            const errorText =
                await response.text();

            throw new Error(
                `FYERS history HTTP ${response.status}: ${errorText}`
            );

        }

        const data =
            await response.json();

        const history =
            Array.isArray(data?.candles)
                ? data.candles
                : Array.isArray(data)
                    ? data
                    : [];

        console.log(
            "[ChartWindow] FYERS history response",
            {
                requestedSymbol: symbol,
                fyersSymbol,
                timeframe,
                count: history.length,
                first: history[0],
                last:
                    history[
                        history.length - 1
                    ]
            }
        );

        if (!mounted) {
            return;
        }

        if (history.length === 0) {

            console.warn(
                "[ChartWindow] FYERS returned zero candles."
            );

            setCandles([]);
            setFeedError(
                "FYERS returned no historical candles."
            );

            return;

        }

        setCandles(history);

        setFeedError(null);

        console.log(
            "[ChartWindow] FYERS candles pushed to ChartEngine",
            {
                count: history.length
            }
        );

    }
    catch (error) {

        if (!mounted) {
            return;
        }

        console.error(
            "[ChartWindow] FYERS history FAILED",
            error
        );

        setCandles([]);

        setFeedError(
            error instanceof Error
                ? error.message
                : "Unable to load FYERS historical data."
        );

    }

}

    //--------------------------------------------------
    // ALICE BLUE HISTORY
    //
    // Store-first backend now: this call is almost always
    // an instant local read, not a broker round-trip. The
    // response carries a `freshness` field describing the
    // store copy, independent of whether history.length is
    // 0 or not.
    //
    // - history.length > 0            -> render candles,
    //   show a "synced Xm ago" badge, never a hard error.
    // - history.length === 0 AND the
    //   store has never had this key  -> this is a true
    //   cold key waiting on its very first sync (or the
    //   broker/session genuinely has nothing). Show a
    //   soft "waiting for first sync" message, not the old
    //   alarming red error box.
    //--------------------------------------------------

    async function loadAliceBlueHistory() {

        if (
            datasource !== "AliceBlue" &&
            datasource !== "aliceblue"
        ) {
            return;
        }

        if (!aliceBlueLoggedIn) {

            console.log(
                "[ChartWindow] Alice Blue history skipped - not logged in."
            );

            return;

        }

        if (!symbol) {

            console.log(
                "[ChartWindow] Alice Blue history skipped - no symbol."
            );

            return;

        }

        try {

            console.log(
                "[ChartWindow] Loading Alice Blue history",
                {
                    symbol,
                    chartSymbol,
                    underlying,
                    expiry,
                    strike,
                    optionType,
                    timeframe
                }
            );

            //--------------------------------------------------
            // ALICEBLUE OPTION RESOLUTION
            //--------------------------------------------------

            let aliceBlueHistorySymbol =
                String(symbol ?? "").trim();

            const aliceBlueUnderlying =
                String(underlying ?? "")
                    .trim()
                    .toUpperCase()
                    .replace(/-EQ$/i, "");

            const isAliceBlueOption =
                Boolean(
                    aliceBlueUnderlying &&
                    expiry &&
                    Number.isFinite(strike) &&
                    optionType &&
                    /^(CE|PE)$/i.test(optionType)
                );

            if (isAliceBlueOption) {

                const resolveResponse =
                    await fetch(
                        `/api/aliceblue/options/resolve?underlying=${encodeURIComponent(
                            aliceBlueUnderlying
                        )}&expiry=${encodeURIComponent(
                            expiry ?? ""
                        )}&strike=${encodeURIComponent(
                            String(strike)
                        )}&type=${encodeURIComponent(
                            String(optionType).toUpperCase()
                        )}`
                    );

                const resolved =
                    await resolveResponse.json();

                if (!resolveResponse.ok) {
                    throw new Error(
                        resolved?.error ??
                        `Alice Blue option resolution failed: ${resolveResponse.status}`
                    );
                }

                const contract =
                    resolved?.result ??
                    resolved?.contract ??
                    resolved;

                const token =
                    contract?.token ??
                    contract?.instrumentToken ??
                    contract?.instrument_token;

                const exchange =
                    contract?.exchange ??
                    "NFO";

                if (!token) {
                    throw new Error(
                        `Unable to resolve ${symbol} to an Alice Blue instrument token`
                    );
                }

                aliceBlueHistorySymbol =
                    `${exchange}|${token}`;

                console.log(
                    "[ChartWindow] Alice Blue option resolved",
                    {
                        requestedSymbol: symbol,
                        underlying: aliceBlueUnderlying,
                        expiry,
                        strike,
                        optionType,
                        nativeSymbol: aliceBlueHistorySymbol,
                        token
                    }
                );
            }

            const optionParams =
                isAliceBlueOption
                    ? `&underlying=${encodeURIComponent(aliceBlueUnderlying)}&expiry=${encodeURIComponent(expiry ?? "")}&strike=${encodeURIComponent(String(strike))}&optionType=${encodeURIComponent(String(optionType).toUpperCase())}`
                    : "";

            const response =
                await fetch(
                    `/api/aliceblue/history?symbol=${encodeURIComponent(
                        aliceBlueHistorySymbol
                    )}&timeframe=${encodeURIComponent(
                        timeframe
                    )}${optionParams}`
                );
              if (!response.ok) {

                  let reason: string | undefined;
                  let details: string | undefined;

                  try {
                      const errorBody = await response.json();
                      reason = errorBody?.reason;
                      details = errorBody?.details ?? errorBody?.error;
                  } catch {
                      // response body wasn't JSON — fall through to generic message
                  }

                  const FRIENDLY_REASONS: Record<string, string> = {
                      RESOLUTION_NOT_SUPPORTED:
                          "AliceBlue only supports 1-minute and Daily candles. Switch this chart to 1m or 1D.",
                      EXCHANGE_NOT_SUPPORTED:
                          "AliceBlue doesn't provide chart data for this exchange yet (e.g. SENSEX/BANKEX). Try another feed for this symbol.",
                      SESSION_EXPIRED:
                          "AliceBlue session has expired. Log in again via /api/aliceblue/login."
                  };

                  throw new Error(
                      (reason && FRIENDLY_REASONS[reason]) ||
                      details ||
                      `Alice Blue history request failed: ${response.status}`
                  );
              }

              const data =
                  await response.json();

            //--------------------------------------------------
            // Response shape is now { candles, freshness }.
            // Stay tolerant of a bare array too, in case an
            // older cached bundle or a different code path
            // ever returns one.
            //--------------------------------------------------

            const history =
                Array.isArray(data)
                    ? data
                    : Array.isArray(data?.candles)
                        ? data.candles
                        : [];

            const freshness: AliceBlueFreshness | null =
                Array.isArray(data)
                    ? null
                    : (data?.freshness ?? null);

            console.log(
                "[ChartWindow] Alice Blue history received",
                {
                    symbol,
                    timeframe,
                    count: history.length,
                    freshness,
                    first: history[0],
                    last:
                        history[
                            history.length - 1
                        ]
                }
            );

            if (!mounted) {
                return;
            }

            setCandles(history);

            setAliceBlueFreshness(freshness);

            if (history.length > 0) {

                // Store has candles — never a hard error, the
                // freshness badge in the UI carries the "how
                // current is this" signal instead.
                setFeedError(null);

            }
            else if (freshness?.hasCache) {

                // Shouldn't normally happen (the store only
                // ever holds non-empty candle arrays), but if
                // it does, don't scare the user — just say
                // syncing is in progress.
                setFeedError(null);

            }
            else {

                // Truly nothing yet: first-ever request for
                // this symbol/timeframe, cold-start fetch
                // hasn't landed anything.
                setFeedError(
                    "Waiting for first Alice Blue sync for this symbol..."
                );

            }

        }
        catch (error: unknown) {

            if (!mounted) {
                return;
            }

            console.error(
                "[ChartWindow] Alice Blue history failed",
                error
            );

            // A request failure (network/HTTP error) doesn't
            // necessarily mean there's nothing to show — keep
            // whatever candles are already on screen and only
            // surface the error banner if we have nothing.
            setFeedError(
                error instanceof Error
                    ? error.message
                    : "Unable to load Alice Blue historical data."
            );

        }

    }

    //--------------------------------------------------
    // INDSTOCKS HISTORY
    //
    // No login/OAuth step - token refresh is fully
    // server-side via TOTP. Always attempt directly.
    //--------------------------------------------------

    async function loadIndstocksHistory() {

        if (datasource !== "IndStocks" && datasource !== "indstocks") {
            return;
        }

        if (!symbol) {
            return;
        }

        try {

            console.log(
                "[ChartWindow] Loading IndStocks history",
                {
                    requestedSymbol:
                        symbol,

                    canonicalSymbol:
                        chartSymbol,

                    timeframe
                }
            );

            const indstocksSymbol =
                chartSymbol;

            const response =
                await fetch(
                    `/api/indstocks/history?symbol=${encodeURIComponent(
                        indstocksSymbol
                    )}&timeframe=${encodeURIComponent(
                        timeframe
                    )}`
                );

            if (!response.ok) {

                let details: string | undefined;

                try {
                    const errorBody = await response.json();
                    details = errorBody?.details ?? errorBody?.error;
                } catch {
                    // not JSON
                }

                throw new Error(details || `IndStocks history request failed: ${response.status}`);

            }

            const data = await response.json();

            const history =
                Array.isArray(data)
                    ? data
                    : Array.isArray(data?.candles)
                        ? data.candles
                        : [];

            if (!mounted) {
                return;
            }

            setCandles(
                history
            );

            setFeedError(
                history.length > 0
                    ? null
                    : "IndStocks returned no historical candles."
            );

        }
        catch (error: unknown) {

            if (!mounted) {
                return;
            }

            console.error("[ChartWindow] IndStocks history failed", error);

            setFeedError(
                error instanceof Error
                    ? error.message
                    : "Unable to load IndStocks historical data."
            );

        }

    }

    //--------------------------------------------------
    // BINANCE HISTORY
    //
    // Automatically resolves:
    //
    // BTCUSDT -> BTCUSDT / spot
    // ETHUSDT -> ETHUSDT / spot
    // SOLUSDT -> SOLUSDT / spot
    // XAUUSD  -> XAUUSDT / futures
    //
    // No Futures selector is required in the UI.
    //--------------------------------------------------

    async function loadBinanceHistory() {

        if (!symbol) {
            return;
        }

        try {

            let resolved =
                binanceResolvedRef.current;

            if (
                !resolved ||
                resolved.requestedSymbol !== symbol
            ) {

                resolved =
                    await resolveBinanceInstrument(
                        symbol
                    );

                if (!mounted) {
                    return;
                }

                binanceResolvedRef.current =
                    resolved;

            }

            console.log(
                "[BINANCE RESOLVER]",
                {
                    requestedSymbol:
                        symbol,

                    binanceSymbol:
                        resolved.binanceSymbol,

                    market:
                        resolved.market
                }
            );

            const response =
                await fetch(
                    `/api/binance/${encodeURIComponent(
                        resolved.binanceSymbol
                    )}?timeframe=${encodeURIComponent(
                        timeframe
                    )}&market=${encodeURIComponent(
                        resolved.market
                    )}`
                );

            if (!response.ok) {

                const errorText =
                    await response.text();

                throw new Error(
                    `Binance history request failed: ${response.status} ${errorText}`
                );

            }

            const raw =
                await response.json();

            const history =
                Array.isArray(raw)
                    ? raw
                        .map(
                            (k: any) => ({

                                time:
                                    Math.floor(
                                        Number(k[0]) / 1000
                                    ),

                                open:
                                    Number(k[1]),

                                high:
                                    Number(k[2]),

                                low:
                                    Number(k[3]),

                                close:
                                    Number(k[4]),

                                volume:
                                    Number(k[5]) || 0

                            })
                        )
                        .filter(
                            (c: Candle) =>
                                Number.isFinite(c.time) &&
                                Number.isFinite(c.open) &&
                                Number.isFinite(c.high) &&
                                Number.isFinite(c.low) &&
                                Number.isFinite(c.close)
                        )
                    : [];

            if (!mounted) {
                return;
            }

            if (!history.length) {

                console.warn(
                    "[BINANCE] No historical candles",
                    {
                        requestedSymbol:
                            symbol,

                        binanceSymbol:
                            resolved.binanceSymbol,

                        market:
                            resolved.market
                    }
                );

                setCandles([]);

                return;

            }

            setCandles(
                history
            );

            setFeedError(
                null
            );

        }
        catch (error) {

            if (!mounted) {
                return;
            }

            console.error(
                "[BINANCE HISTORY ERROR]",
                error
            );

            setCandles([]);

            setFeedError(
                error instanceof Error
                    ? error.message
                    : "Unable to load Binance historical data."
            );

        }

    }

    //--------------------------------------------------
    // YAHOO HISTORY
    //--------------------------------------------------

    async function loadYahooHistory() {

        if (!yahooSymbol) {

            if (mounted) {

                setCandles([]);

                setFeedError(
                    "No Yahoo symbol resolved."
                );

            }

            return;

        }

        const resolvedYahooSymbol =
            yahooSymbol;

        try {

            const response =
                await fetch(
                    `/api/yahoo/${encodeURIComponent(
                        resolvedYahooSymbol
                    )}?timeframe=${encodeURIComponent(
                        timeframe
                    )}`
                );

            if (!response.ok) {

                throw new Error(
                    `Yahoo history request failed: ${response.status}`
                );

            }

            const data =
                await response.json();

            const history =
                Array.isArray(data)
                    ? data
                    : Array.isArray(data?.candles)
                        ? data.candles
                        : [];

            if (!mounted) {
                return;
            }

            setCandles(history);

            setFeedError(
                history.length > 0
                    ? null
                    : "Yahoo returned no historical candles."
            );

        }
        catch (error: unknown) {

            if (!mounted) {
                return;
            }

            AJLoggingGate.error(
                "[ChartWindow]",
                error
            );

            setFeedError(
                error instanceof Error
                    ? error.message
                    : "Unable to load Yahoo data."
            );

        }

    }

    //--------------------------------------------------
    // DATASOURCE ROUTING
    //--------------------------------------------------

    const normalizedDatasource =
        String(datasource ?? "")
            .trim()
            .toLowerCase();

    //--------------------------------------------------
    // FYERS
    //--------------------------------------------------

    if (
        normalizedDatasource === "fyers"
    ) {

        setCandles([]);
        setFeedError(null);

        if (!fyersLoggedIn) {

            return () => {

                mounted = false;

            };

        }

        loadFyersHistory();

        const timer =
            window.setInterval(
                loadFyersHistory,
                15000
            );

        return () => {
            mounted = false;
            window.clearInterval(timer);
        };
    }

    //--------------------------------------------------
    // ALICE BLUE
    //--------------------------------------------------

    if (
        normalizedDatasource === "aliceblue"
    ) {

        setCandles([]);
        setFeedError(null);
        setAliceBlueFreshness(null);

        if (!aliceBlueLoggedIn) {

            return () => {

                mounted = false;

            };

        }

        loadAliceBlueHistory();

        //--------------------------------------------------
        // Poll every 10s. This is still cheap now that
        // getAliceBlueHistory is store-first — most of
        // these ticks are a local disk read, not a broker
        // call, so there's no reason to reduce frequency.
        //--------------------------------------------------

        const timer =
            window.setInterval(
                loadAliceBlueHistory,
                10000
            );

        return () => {
            mounted = false;
            window.clearInterval(timer);
        };
    }

    //--------------------------------------------------
    // INDSTOCKS
    //--------------------------------------------------

    if (
        normalizedDatasource === "indstocks"
    ) {

        setCandles([]);
        setFeedError(null);

        loadIndstocksHistory();

        const timer =
            window.setInterval(
                loadIndstocksHistory,
                10000
            );

        return () => {
            mounted = false;
            window.clearInterval(timer);
        };
    }

    //--------------------------------------------------
    // BINANCE
    //--------------------------------------------------

    if (
        normalizedDatasource === "binance"
    ) {

        setCandles([]);
        setFeedError(null);

        loadBinanceHistory();

        const timer =
            window.setInterval(
                loadBinanceHistory,
                5000
            );

        return () => {
            mounted = false;
            window.clearInterval(timer);
        };
    }

    //--------------------------------------------------
    // ONLY YAHOO USES THIS DIRECT HTTP PATH
    //--------------------------------------------------

    if (
        normalizedDatasource !== "yahoo"
    ) {

        setCandles([]);
        setFeedError(null);

        return () => {

            mounted = false;

        };

    }

    //--------------------------------------------------
    // YAHOO
    //--------------------------------------------------

    setCandles([]);
    setFeedError(null);

    loadYahooHistory();

    const timer =
        window.setInterval(
            loadYahooHistory,
            15000
        );

    return () => {
        mounted = false;
        window.clearInterval(timer);
    };
}, [
    yahooSymbol,
    timeframe,
    datasource,
    zerodhaLoggedIn,
    fyersLoggedIn,
    aliceBlueLoggedIn,
    symbol,
    chartSymbol,
    underlying,
    expiry,
    strike,
    optionType
]);

    //--------------------------------------------------
    // RUNTIME ENGINE
    //--------------------------------------------------
    useEffect(() => {

        if (
            !runtimeContext
        ) {
            setRuntimeResult(
                null
            );
            setHostResult(
                null
            );
            return;
        }
        const runtime =
            runtimeEngineRef
                .current
                .evaluate(
                    runtimeContext
                );
        setRuntimeResult(
            runtime
        );
    }, [
        runtimeContext
    ]);

    //--------------------------------------------------
    // HOST ADAPTER + AJ DEBUG FEED
    //--------------------------------------------------
    
    useEffect(() => {
    
        if (
            !runtimeResult
        ) {
            setHostResult(
                null
            );
            return;
        }
 
    //--------------------------------------------------
    // AJ DISABLED ON THIS CHART
    // DO NOT CLEAR GLOBAL DEBUG
    //--------------------------------------------------
    
    if (
        !indicators.ajindicator
    ) {
        setHostResult(
            null
        );
        return;
    }

    //--------------------------------------------------
    // AJ INDICATOR PIPELINE
    //--------------------------------------------------
    
    const host =
        AJHost.run(
            runtimeResult
        );
    setHostResult(
        host
    );
    
    //--------------------------------------------------
    // GLOBAL DEBUG FEED
    //--------------------------------------------------
    
    DebugEngine.update(
        chartId,
        host
    );
    },[
        runtimeResult,
        indicators.ajindicator
    ]);
	
	//--------------------------------------------------
    // ACTIVE CHART CONTEXT
    //--------------------------------------------------

    useEffect(()=>{
        if (!isActive) {
            return;
        }
        ActiveChartStore.setActiveChart(chartId);
        DebugEngine.setActiveChart(chartId);
        AJDashboardAdapter.setActiveChart(chartId);
    }, [
        chartId,
        isActive
    ]);

    //--------------------------------------------------
    // DEVELOPMENT LOGGING
    //--------------------------------------------------

    useEffect(() => {

        if (
            !import.meta.env.DEV
        ) {
            return;
        }

        AJLoggingGate.log(
            "[RuntimeResult]",
            runtimeResult
        );

        AJLoggingGate.log(
            "[HostResult]",
            hostResult
        );
    }, [
        runtimeResult,
        hostResult
    ]);

	//=================================================
	// FYERS LOGIN
	//=================================================
	
	function loginToFyers() {
	
		setFyersStatus(
			"connecting"
		);
	
		setFyersMessage(
			"Opening Fyers authentication..."
		);
	
		//------------------------------------------------
		// IMPORTANT:
		//
		// Open Fyers OAuth in a NEW WINDOW.
		//
		// The callback uses window.opener.postMessage()
		// to return the authentication result to this
		// existing ChartWindow.
		//------------------------------------------------
	
		window.open(
			"https://localhost:3001/api/fyers/login",
			"_blank",
			"width=500,height=700"
		);
	
	}

	//=================================================
	// ALICE BLUE LOGIN
	//=================================================
	
	function loginToAliceBlue() {
	
		setAliceBlueStatus(
			"connecting"
		);
	
		setAliceBlueMessage(
			"Opening Alice Blue authentication..."
		);
	
		window.open(
	
			"https://localhost:3001/api/aliceblue/login",
	
			"_blank",
	
			"width=500,height=700"
	
		);
	
	}
	
	//=================================================
	// FYERS LOGIN SUCCESS
	//=================================================
	
	useEffect(() => {
	
		function onMessage(
			event: MessageEvent
		) {
	
			if (
				event.data?.type !==
				"FYERS_LOGIN_SUCCESS"
			) {
				return;
			}
	
			setFyersLoggedIn(
				true
			);
	
			setFyersStatus(
				"connected"
			);
	
			setFyersMessage(
				"Fyers authentication successful."
			);
	
		}
	
		window.addEventListener(
			"message",
			onMessage
		);
	
		return () =>
			window.removeEventListener(
				"message",
				onMessage
			);
	
	}, []);
	
	//=================================================
	// ALICE BLUE LOGIN SUCCESS
	//=================================================
	
	useEffect(() => {
	
		function onMessage(
			event: MessageEvent
		) {
	
			if (
				event.data?.type !==
				"ALICEBLUE_LOGIN_SUCCESS"
			) {
				return;
			}
	
			fetch(
				"https://localhost:3001/api/aliceblue/status"
			)
	
			.then(
				response =>
					response.json()
			)
	
			.then(
				status => {
	
					const loggedIn =
						status?.loggedIn === true;
	
					setAliceBlueLoggedIn(
						loggedIn
					);
	
					setAliceBlueStatus(
						loggedIn
							? "connected"
							: "login_required"
					);
	
					setAliceBlueMessage(
	
						loggedIn
	
							? "Alice Blue authentication successful."
	
							: "Alice Blue authentication failed."
	
					);
	
				}
			)
	
			.catch(
				() => {
	
					setAliceBlueLoggedIn(
						false
					);
	
					setAliceBlueStatus(
						"server_unavailable"
					);
	
					setAliceBlueMessage(
						"Unable to contact Alice Blue service."
					);
	
				}
			);
	
		}
	
		window.addEventListener(
			"message",
			onMessage
		);
	
		return () => {
	
			window.removeEventListener(
				"message",
				onMessage
			);
	
		};
	
	}, []);

	//=================================================
	// Zerodha Login successful
	//================================================
	
	useEffect(() => {

		function onMessage(event: MessageEvent) {
			if (
				event.data?.type !==
				"ZERODHA_LOGIN_SUCCESS"
			) {
				return;
			}
			fetch(
				"https://localhost:3001/api/zerodha/session"
			)
			.then(r => r.json())
			.then(session => {
				setZerodhaLoggedIn(
					session.loggedIn === true
				);
			});
		}
		window.addEventListener(
			"message",
			onMessage
		);
	
		return () =>
			window.removeEventListener(
				"message",
				onMessage
			);
	}, []);
		
    //==================================================
    // BINANCE LIVE STREAM
    //
    // Uses EXACTLY the same automatic resolver as the
    // historical REST path.
    //
    // Spot:
    //   wss://stream.binance.com:9443/ws/...
    //
    // Futures:
    //   wss://fstream.binance.com/ws/...
    //==================================================

    useEffect(() => {

        const normalized =
            String(datasource ?? "")
                .trim()
                .toLowerCase();

        if (
            normalized !== "binance"
        ) {

            return;

        }

        if (!symbol) {
            return;
        }

        let cancelled =
            false;

        let ws:
            WebSocket | null =
            null;

        async function connectBinanceWebSocket() {

            try {

                //--------------------------------------------------
                // Reuse the exact resolution obtained by history
                // whenever available.
                //--------------------------------------------------

                let resolved =
                    binanceResolvedRef.current;

                if (
                    !resolved ||
                    resolved.requestedSymbol !== symbol
                ) {

                    resolved =
                        await resolveBinanceInstrument(
                            symbol
                        );

                    if (
                        cancelled
                    ) {

                        return;

                    }

                    binanceResolvedRef.current =
                        resolved;

                }

                if (
                    cancelled
                ) {

                    return;

                }

                const binanceSymbol =
                    resolved.binanceSymbol
                        .toLowerCase();

                const binanceInterval =
                    String(
                        timeframe ?? "1m"
                    )
                        .trim()
                        .toLowerCase();

                const websocketBase =
                    resolved.market === "futures"

                        ? "wss://fstream.binance.com/ws"

                        : "wss://stream.binance.com:9443/ws";

                const websocketUrl =
                    `${websocketBase}/${binanceSymbol}@kline_${binanceInterval}`;

                console.log(
                    "[BINANCE WS CONNECT]",
                    {
                        requestedSymbol:
                            symbol,

                        binanceSymbol:
                            resolved.binanceSymbol,

                        market:
                            resolved.market,

                        websocketUrl
                    }
                );

                ws =
                    new WebSocket(
                        websocketUrl
                    );

                ws.onmessage =
                    event => {

                        try {

                            const message =
                                JSON.parse(
                                    String(
                                        event.data
                                    )
                                );

                            const k =
                                message?.k;

                            if (!k) {
                                return;
                            }

                            const candle: Candle = {

                                time:
                                    Math.floor(
                                        Number(k.t) / 1000
                                    ),

                                open:
                                    Number(k.o),

                                high:
                                    Number(k.h),

                                low:
                                    Number(k.l),

                                close:
                                    Number(k.c),

                                volume:
                                    Number(k.v) || 0

                            };

                            setCandles(
                                previous => {

                                    if (
                                        !previous.length
                                    ) {

                                        return [
                                            candle
                                        ];

                                    }

                                    const last =
                                        previous[
                                            previous.length - 1
                                        ];

                                    if (
                                        last.time ===
                                        candle.time
                                    ) {

                                        return [

                                            ...previous.slice(
                                                0,
                                                -1
                                            ),

                                            candle

                                        ];

                                    }

                                    if (
                                        candle.time >
                                        last.time
                                    ) {

                                        return [

                                            ...previous,

                                            candle

                                        ];

                                    }

                                    return previous;

                                }
                            );

                        }
                        catch (error) {

                            console.error(
                                "[BINANCE WS ERROR]",
                                error
                            );

                        }

                    };

                ws.onerror =
                    error => {

                        console.error(
                            "[BINANCE WS CONNECTION ERROR]",
                            {
                                requestedSymbol:
                                    symbol,

                                binanceSymbol:
                                    resolved?.binanceSymbol,

                                market:
                                    resolved?.market,

                                error
                            }
                        );

                    };

            }
            catch (error) {

                if (
                    cancelled
                ) {

                    return;

                }

                console.error(
                    "[BINANCE WS RESOLUTION ERROR]",
                    error
                );

                setFeedError(
                    error instanceof Error
                        ? error.message
                        : "Unable to resolve Binance market."
                );

            }

        }

        connectBinanceWebSocket();

        return () => {

            cancelled = true;

            if (ws) {

                try {
                    ws.close();
                }
                catch {
                    // ignore
                }

                ws = null;

            }

        };

    }, [
        datasource,
        symbol,
        timeframe
    ]);

    //--------------------------------------------------
    // UI
    //--------------------------------------------------
	
	    return (

        <div
            style={{
                width: "100%",
                height: "100%",
                minWidth: 0,
                minHeight: 0,
                display: "flex",
                flexDirection: "column",
                background: "var(--bg-panel)",
                border: isActive ? "1px solid var(--success)" : "1px solid var(--border-primary)",
                boxShadow: isActive ? "inset 0 0 0 1px rgba(76,175,80,0.18)" : "none",
                overflow: "hidden",
                cursor: "default"
            }}
            onClick={onActivate}
        >

            {/*==========================================
                CHART HEADER
            ==========================================*/}

            <div
                style={{
                    height: 24,
                    minHeight: 24,
                    display: "flex",
                    alignItems: "center",
                    padding: "0 8px",
                    background: "var(--bg-chart-header)",
                    borderBottom: "1px solid var(--border-primary)",
                    color: "var(--text-primary)",
                    fontSize: 12,
                    fontWeight: 700,
                    cursor: "pointer",
                    userSelect: "none",
                    flexShrink: 0
                }}
                onClick={onActivate}
                title="Select chart"
			>
                {datasource}:{displayName || chartSymbol}:{timeframe}:
				{
					Object.entries(indicators)
						.filter(([, enabled]) => enabled)
						.map(([name]) => name.toUpperCase())
						.join(",")
				}
			</div>

            {/*==========================================
                CHART
            ==========================================*/}

            <div

                style={{
                    flex:1,
                    minWidth:0,
                    minHeight:0,
                    position:"relative",
                    overflow:"hidden"
                }}

            >
				{
					feedError && (
						<div
							style={{
								position: "absolute",
								top: 10,
								right: 10,
								zIndex: 9999,
								padding: "8px 12px",
								background: "#5c1f1f",
								color: "#fff",
								fontSize: 12,
								borderRadius: 4
							}}
						>
							{feedError}
						</div>
					)
				}

				{/*================================================
					ALICE BLUE FRESHNESS BADGE
					Only rendered when there's no blocking
					feedError AND we actually have a freshness
					reading from the store. Subtle, corner
					badge — not meant to compete for attention
					with the chart itself.
				================================================*/}

				{
					(
						datasource === "AliceBlue" ||
						datasource === "aliceblue"
					) &&
					!feedError &&
					aliceBlueFreshness?.hasCache && (
						<div
							title={
								aliceBlueFreshness.cachedAt
									? `Last synced: ${new Date(aliceBlueFreshness.cachedAt).toLocaleTimeString()}`
									: undefined
							}
							style={{
								position: "absolute",
								top: 10,
								right: 10,
								zIndex: 9999,
								padding: "3px 8px",
								background: "rgba(20,20,20,0.75)",
								color: "#8fae8f",
								fontSize: 10,
								borderRadius: 4,
								border: "1px solid #2b3b2b",
								userSelect: "none",
								pointerEvents: "none"
							}}
						>
							synced {formatFreshnessAge(aliceBlueFreshness.ageMs)}
						</div>
					)
				}
				
				{/*================================================
					ZERODHA AUTH UI
				================================================*/}
				
				{
					(
						datasource === "zerodha" ||
						datasource === "Zerodha"
					) && !zerodhaLoggedIn && (
						<div
							style={{
								padding: 20,
								display: "flex",
								flexDirection: "column",
								alignItems: "center",
								justifyContent: "center",
								gap: 10
							}}
						>
							{
								checkingSession ? (
									<div>
										Checking Zerodha session...
									</div>
								) : (
									<>
										<div
											style={{
												textAlign: "center",
												lineHeight: 1.6
											}}
										>
											<div
												style={{
													fontWeight: "bold",
													fontSize: 16
												}}
											>
												Zerodha
											</div>
				
											<div>
												Status:
												<b>
													{
														zerodhaStatus === "connected"
															? " Connected"
															: zerodhaStatus === "subscription_required"
																? " Subscription Required"
																: zerodhaStatus === "oauth_failed"
																	? " OAuth Failed"
																	: zerodhaStatus === "session_expired"
																		? " Session Expired"
																		: zerodhaStatus === "login_required"
																			? " Login Required"
																			: zerodhaStatus === "server_unavailable"
																				? " Server Unavailable"
																				: ` ${zerodhaStatus}`
													}
												</b>
											</div>
				
											{
												zerodhaMessage && (
													<div
														style={{
															color: "#ffb366",
															maxWidth: 320
														}}
													>
														{zerodhaMessage}
													</div>
												)
											}
										</div>
				
										<button
											onClick={() =>
												window.open(
													"https://localhost:3001/api/zerodha/login",
													"_blank"
												)
											}
										>
											Login to Zerodha
										</button>
									</>
								)
							}
						</div>
					)
				}
				
				{/*================================================
					FYERS AUTH UI
				================================================*/}
				
				{
					datasource === "Fyers" &&
					!fyersLoggedIn && (
						<div
							style={{
								padding: 20,
								display: "flex",
								flexDirection: "column",
								alignItems: "center",
								justifyContent: "center",
								gap: 12
							}}
						>
							<div
								style={{
									textAlign: "center",
									lineHeight: 1.6
								}}
							>
								<div
									style={{
										fontWeight: "bold",
										fontSize: 16
									}}
								>
									Fyers
								</div>
				
								<div>
									Status:
									<b>
										{
											fyersStatus === "connecting"
												? " Connecting..."
												: fyersStatus === "checking"
													? " Checking..."
													: fyersStatus === "connected"
														? " Connected"
														: fyersStatus === "server_unavailable"
															? " Server Unavailable"
															: " Login Required"
										}
									</b>
								</div>
				
								{
									fyersMessage && (
										<div
											style={{
												color: "#ffb366",
												maxWidth: 360
											}}
										>
											{fyersMessage}
										</div>
									)
								}
							</div>
				
							<button
								onClick={loginToFyers}
								disabled={
									fyersStatus === "connecting"
								}
							>
								{
									fyersStatus === "connecting"
										? "Opening Fyers..."
										: "Login to Fyers"
								}
							</button>
						</div>
					)
				}
				
				{/*================================================
					ALICE BLUE AUTH UI
				================================================*/}
				
				{
					(
						datasource === "AliceBlue" ||
						datasource === "aliceblue"
					) &&
					!aliceBlueLoggedIn && (
						<div
							style={{
								padding: 20,
								display: "flex",
								flexDirection: "column",
								alignItems: "center",
								justifyContent: "center",
								gap: 12
							}}
						>
							{
								aliceBlueStatus === "checking" ? (
									<div>
										Checking Alice Blue session...
									</div>
								) : (
									<>
										<div
											style={{
												textAlign: "center",
												lineHeight: 1.6
											}}
										>
											<div
												style={{
													fontWeight: "bold",
													fontSize: 16
												}}
											>
												Alice Blue
											</div>
				
											<div>
												Status:
												<b>
													{
														aliceBlueStatus === "connecting"
															? " Connecting..."
															: aliceBlueStatus === "server_unavailable"
																? " Server Unavailable"
																: " Login Required"
													}
												</b>
											</div>
				
											{
												aliceBlueMessage && (
													<div
														style={{
															color: "#ffb366",
															maxWidth: 360
														}}
													>
														{aliceBlueMessage}
													</div>
												)
											}
										</div>
				
										<button
											onClick={loginToAliceBlue}
											disabled={
												aliceBlueStatus === "connecting"
											}
										>
											{
												aliceBlueStatus === "connecting"
													? "Opening Alice Blue..."
													: "Login to Alice Blue"
											}
										</button>
									</>
								)
							}
						</div>
					)
				}
				
				{/*================================================
					AUTHENTICATED STATUS
				================================================*/}
				
				{/* Fyers connected status intentionally hidden.
					Feed green-light indicator is the only connection status UI. */}
				
				{/*================================================
					CHART ENGINE
				================================================*/}
				
				{
					(
						(
							datasource !== "zerodha" &&
							datasource !== "Zerodha" &&
							datasource !== "Fyers" &&
							datasource !== "AliceBlue" &&
							datasource !== "aliceblue"
						)
						||
						(
							(
								datasource === "zerodha" ||
								datasource === "Zerodha"
							) &&
							zerodhaLoggedIn
						)
						||
						(
							datasource === "Fyers" &&
							fyersLoggedIn
						)
						||
						(
							(
								datasource === "AliceBlue" ||
								datasource === "aliceblue"
							) &&
							aliceBlueLoggedIn
						)
					) && (
						<ChartErrorBoundary>
							<ChartEngine
								chartId={chartId}
								candles={candles}
								symbol={chartSymbol}
								timeframe={timeframe}
								indicators={indicators}
								hostResult={hostResult}
								candleColors={candleColors}
								onCandleColorsChange={onCandleColorsChange}
							/>
						</ChartErrorBoundary>
					)
				}

            </div>



        </div>

    );

}




