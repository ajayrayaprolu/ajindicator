//======================================================
// server/aliceblue/symbols.js.new
//
// Alice Blue Contract Master / Symbol Catalog
//
// Responsibilities:
//
//  1. Download Alice Blue contract master
//  2. Store contracts locally
//  3. Search symbols
//  4. Search option contracts
//  5. Resolve trading symbol -> token
//  6. Resolve token -> contract
//  7. Refresh contract master periodically
//
// AJ Institutional Terminal
//======================================================

import fs from "fs";
import path from "path";
import axios from "axios";

//======================================================
// CONFIGURATION
//======================================================

const DATA_DIR =
    path.resolve(
        process.cwd(),
        "server",
        "aliceblue",
        "data"
    );

const MASTER_FILE =
    path.join(
        DATA_DIR,
        "contract-master.json"
    );

// Alice Blue contract-master endpoint.
//
// The contract-master data is used to obtain the
// exchange/token/trading-symbol relationship required
// for market-data operations.

const CONTRACT_MASTER_URL =
    "https://v2api.aliceblueonline.com/restpy/contract_master";

// Refresh every 30 minutes by default.
const REFRESH_INTERVAL_MS =
    Number(
        process.env.ALICEBLUE_SYMBOL_REFRESH_MS ??
        30 * 60 * 1000
    );

//======================================================
// STATE
//======================================================

let contracts = [];

let loaded = false;

let lastRefresh = 0;

let refreshTimer = null;

// Fast indexes
const tokenIndex =
    new Map();

const symbolIndex =
    new Map();

const exchangeSymbolIndex =
    new Map();

const optionIndex =
    new Map();

//======================================================
// DIRECTORY
//======================================================

function ensureDataDirectory() {

    if (
        !fs.existsSync(
            DATA_DIR
        )
    ) {

        fs.mkdirSync(
            DATA_DIR,
            {
                recursive: true
            }
        );

    }

}

//======================================================
// NORMALIZATION
//======================================================

function stringValue(value) {

    if (
        value === undefined ||
        value === null
    ) {

        return "";

    }

    return String(
        value
    ).trim();

}

//======================================================

function normalizeExchange(value) {

    return stringValue(
        value
    )
        .toUpperCase()
        .replace(
            "_CM",
            ""
        )
        .replace(
            "_FO",
            ""
        );

}

//======================================================

function normalizeSymbol(value) {

    return stringValue(
        value
    )
        .toUpperCase()
        .trim();

}

//======================================================

function numberValue(value) {

    if (
        value === undefined ||
        value === null ||
        value === ""
    ) {

        return undefined;

    }

    const n =
        Number(
            value
        );

    return Number.isFinite(n)
        ? n
        : undefined;

}


//======================================================
// DATE NORMALIZATION
//======================================================

function normalizeExpiry(value) {

    if (
        value === undefined ||
        value === null ||
        value === ""
    ) {

        return null;

    }

    const text =
        String(
            value
        ).trim();

    return text || null;

}

//======================================================
// EXPIRY FROM TRADING SYMBOL
//
// AliceBlue's contract master frequently leaves the raw
// expiry field null even for real option contracts. The
// date is embedded in the trading symbol itself, e.g.:
//
//   NIFTY29DEC26C30000  -> day=29, mon=DEC, yr=26
//   NIFTY08SEP26C26000  -> day=08, mon=SEP, yr=26
//
// Format: <UNDERLYING><DD><MON><YY><C|P><STRIKE>
//======================================================

const MONTH_MAP = {
    JAN: "01", FEB: "02", MAR: "03", APR: "04", MAY: "05", JUN: "06",
    JUL: "07", AUG: "08", SEP: "09", OCT: "10", NOV: "11", DEC: "12"
};

const TRADING_SYMBOL_EXPIRY_RE =
    /^[A-Z]+(\d{2})([A-Z]{3})(\d{2})[CP]\d+(\.\d+)?$/;

function parseExpiryFromTradingSymbol(tradingSymbol) {

    const value = String(tradingSymbol ?? "").trim().toUpperCase();

    const match = TRADING_SYMBOL_EXPIRY_RE.exec(value);

    if (!match) {
        return null;
    }

    const [, day, mon, yy] = match;
    const month = MONTH_MAP[mon];

    if (!month) {
        return null;
    }

    return `20${yy}-${month}-${day.padStart(2, "0")}`; // YYYY-MM-DD
}

//======================================================
// CONTRACT NORMALIZATION
//======================================================

function normalizeContract(raw) {

    if (
        !raw ||
        typeof raw !== "object"
    ) {

        return null;

    }

    const exchange =
        normalizeExchange(
            raw.exch ??
            raw.exchange ??
            raw.exchange_segment
        );

    const token =
        stringValue(
            raw.token ??
            raw.instrumentToken ??
            raw.instrument_token
        );

    const tradingSymbol =
        normalizeSymbol(
            raw.trading_symbol ??
            raw.tradingSymbol ??
            raw.tsym ??
            raw.symbol
        );

    const symbol =
        normalizeSymbol(
            raw.symbol ??
            raw.name ??
            raw.formatted_ins_name ??
            tradingSymbol
        );

    if (
        !exchange &&
        !token &&
        !tradingSymbol
    ) {

        return null;

    }

    const formattedName =
        normalizeSymbol(
            raw.formatted_ins_name ??
            raw.formattedInsName ??
            tradingSymbol ??
            symbol
        );

    const instrumentType =
        stringValue(
            raw.instrument_type ??
            raw.instrumentType
        );

    const groupName =
        stringValue(
            raw.group_name ??
            raw.groupName
        );

    const expiry =
        normalizeExpiry(
            raw.expiry ??
            raw.expiryDate
        ) ??
        parseExpiryFromTradingSymbol(
            raw.trading_symbol ??
            raw.tradingSymbol ??
            raw.tsym
        );

    const strike =
        numberValue(
            raw.strike_price ??
            raw.strikePrice ??
            raw.strike
        );

    const optionType =
        normalizeSymbol(
            raw.option_type ??
            raw.optionType
        );

    const lotSize =
        numberValue(
            raw.lot_size ??
            raw.lotSize
        );

    const tickSize =
        numberValue(
            raw.tick_size ??
            raw.tickSize
        );

    const exchangeSegment =
        stringValue(
            raw.exchange_segment ??
            raw.exchangeSegment
        );

    return {

        exchange,

        exchangeSegment,

        token,

        symbol,

        tradingSymbol,

        formattedName,

        instrumentType,

        groupName,

        expiry,

        strike,

        optionType,

        lotSize,

        tickSize,

        raw

    };

}

//======================================================
// EXTRACT CONTRACT ARRAY
//======================================================

function extractContracts(payload) {

    if (
        Array.isArray(
            payload
        )
    ) {

        return payload;

    }

    if (
        payload &&
        Array.isArray(
            payload.result
        )
    ) {

        return payload.result;

    }

    if (
        payload &&
        Array.isArray(
            payload.data
        )
    ) {

        return payload.data;

    }

    if (
        payload &&
        Array.isArray(
            payload.values
        )
    ) {

        return payload.values;

    }

    if (
        payload &&
        Array.isArray(
            payload.contracts
        )
    ) {

        return payload.contracts;

    }

    //--------------------------------------------------
    // Alice Blue may return the contract master as
    // an object keyed by exchange / token.
    //--------------------------------------------------

    if (
        payload &&
        typeof payload === "object"
    ) {

        const candidates = [];

        for (
            const value
            of Object.values(
                payload
            )
        ) {

            if (
                Array.isArray(
                    value
                )
            ) {

                candidates.push(
                    ...value
                );

            }

        }

        if (
            candidates.length
        ) {

            return candidates;

        }

    }

    return [];

}

//======================================================
// INDEX BUILD
//======================================================

function clearIndexes() {

    tokenIndex.clear();

    symbolIndex.clear();

    exchangeSymbolIndex.clear();

    optionIndex.clear();

}

//======================================================

function addToArrayMap(
    map,
    key,
    value
) {

    if (
        !key
    ) {

        return;

    }

    if (
        !map.has(
            key
        )
    ) {

        map.set(
            key,
            []
        );

    }

    map.get(
        key
    ).push(
        value
    );

}

//======================================================

function buildIndexes() {

    clearIndexes();

    for (
        const contract
        of contracts
    ) {

        //------------------------------------------------
        // TOKEN
        //------------------------------------------------

        if (
            contract.token
        ) {

            tokenIndex.set(
                `${contract.exchange}|${contract.token}`,
                contract
            );

        }

        //------------------------------------------------
        // SYMBOL
        //------------------------------------------------

        const symbol =
            normalizeSymbol(
                contract.tradingSymbol
            );

        if (
            symbol
        ) {

            addToArrayMap(
                symbolIndex,
                symbol,
                contract
            );

        }

        //------------------------------------------------
        // EXCHANGE + SYMBOL
        //------------------------------------------------

        if (
            contract.exchange &&
            symbol
        ) {

            addToArrayMap(
                exchangeSymbolIndex,
                `${contract.exchange}|${symbol}`,
                contract
            );

        }

        //------------------------------------------------
        // OPTIONS
        //------------------------------------------------

        if (
            contract.strike !== undefined ||
            contract.optionType
        ) {

            const underlying =
                extractUnderlying(
                    contract
                );

            const expiry =
                normalizeExpiry(
                    contract.expiry
                );

            const optionType =
                normalizeSymbol(
                    contract.optionType
                );

            const strike =
                contract.strike !== undefined
                    ? String(
                        contract.strike
                    )
                    : "";

            const key =
                [
                    contract.exchange,
                    underlying,
                    expiry ?? "",
                    strike,
                    optionType
                ].join(
                    "|"
                );

            addToArrayMap(
                optionIndex,
                key,
                contract
            );

        }

    }

}

//======================================================
// INDEX DETECTION (module-level � shared by
// getAliceBlueContractBySymbol and toUISymbol so both
// use the same, more reliable text-based heuristic
// instead of just checking exchangeSegment for "idx".)
//======================================================

function isIndexContract(contract) {

    function clean(value) {
        return String(value ?? "").trim().toUpperCase();
    }

    const text = [
        contract?.symbol,
        contract?.tradingSymbol,
        contract?.formattedName,
        contract?.instrumentType,
        contract?.groupName,
        contract?.exchangeSegment,
        contract?.raw?.symbol,
        contract?.raw?.trading_symbol,
        contract?.raw?.formatted_ins_name,
        contract?.raw?.instrument_type,
        contract?.raw?.exchange_segment
    ]
        .map(clean)
        .join(" ");

    return (
        text.includes("INDEX") ||
        text.includes("IDX") ||
        text.includes("NIFTY") ||
        text.includes("BANKNIFTY") ||
        text.includes("FINNIFTY") ||
        text.includes("MIDCPNIFTY") ||
        text.includes("SENSEX") ||
        text.includes("BANKEX")
    );
}

//======================================================
// UNDERLYING EXTRACTION
//======================================================

function extractUnderlying(
    contract
) {

    const direct =
        normalizeSymbol(
            contract.raw?.underlying ??
            contract.raw?.underlyingSymbol ??
            contract.raw?.underlying_symbol
        );

    if (
        direct
    ) {

        return direct;

    }

    // Check tradingSymbol first, not just symbol - AliceBlue
    // stores index rows with a human display name in `symbol`
    // (e.g. "NIFTY BANK") but the actual code name in
    // `tradingSymbol` (e.g. "BANKNIFTY"). Checking only
    // `symbol` misclassifies BANKNIFTY as NIFTY, since
    // "NIFTY BANK" starts with "NIFTY".
    const symbol =
        normalizeSymbol(
            contract.tradingSymbol
        ) ||
        normalizeSymbol(
            contract.symbol
        );
    if (
        symbol === "NIFTY" ||
        symbol === "NIFTY50" ||
        symbol === "NIFTY 50" ||
        (
            symbol.startsWith("NIFTY") &&
            /^\d/.test(symbol.slice(5))
        )
    ) {
        return "NIFTY";
    }
    if (
        symbol === "BANKNIFTY" ||
        (
            symbol.startsWith("BANKNIFTY") &&
            /^\d/.test(symbol.slice(9))
        )
    ) {
        return "BANKNIFTY";
    }
    if (
        symbol.startsWith(
            "FINNIFTY"
        )
    ) {
        return "FINNIFTY";
    }
    if (
        symbol.startsWith(
            "MIDCPNIFTY"
        )
    ) {
        return "MIDCPNIFTY";
    }
    if (
        symbol === "SENSEX" ||
        (
            symbol.startsWith("SENSEX") &&
            /^\d/.test(symbol.slice(6))
        )
    ) {
        return "SENSEX";
    }
    if (
        symbol.startsWith(
            "BANKEX"
        )
    ) {
        return "BANKEX";
    }
    return symbol;
}

//======================================================
// DOWNLOAD CONTRACT MASTER
//======================================================

export async function downloadContractMaster() {

    ensureDataDirectory();

    console.log(
        "[ALICEBLUE SYMBOLS] Downloading contract master..."
    );

    const exchanges = [
        "NSE",
        "NFO",
        "BSE",
        "BFO",
        "CDS",
        "MCX"
    ];

    try {

        const allContracts = [];

        for (const exch of exchanges) {

            console.log(
                `[ALICEBLUE SYMBOLS] Downloading ${exch} contract master...`
            );

            let response;

            try {

                response =
                    await axios.get(
                        "https://v2api.aliceblueonline.com/restpy/contract_master",
                        {
                            params: {
                                exch
                            },
                            timeout: 30000,
                            responseType: "text"
                        }
                    );

            } catch (error) {

                console.warn(
                    `[ALICEBLUE SYMBOLS] ${exch}: request failed (${error?.response?.status ?? error?.message}), skipping this exchange only.`
                );

                continue;
            }

            const body =
                typeof response.data === "string"
                    ? response.data.trim()
                    : response.data;

            console.log(
                `[ALICEBLUE SYMBOLS] ${exch}:`,
                {
                    status: response.status,
                    contentType:
                        response.headers?.["content-type"],
                    length:
                        typeof body === "string"
                            ? body.length
                            : 0
                }
            );

            let parsed = body;

            if (typeof body === "string") {

                try {

                    parsed =
                        JSON.parse(body);

                }
                catch {

                    console.warn(
                        `[ALICEBLUE SYMBOLS] ${exch}: response is not JSON`
                    );

                    continue;

                }

            }

            const rawContracts =
                extractContracts(parsed);

            console.log(
                `[ALICEBLUE SYMBOLS] ${exch}: ${rawContracts.length} raw contracts`
            );

            allContracts.push(
                ...rawContracts
            );

        }

        const normalized =
            allContracts
                .map(normalizeContract)
                .filter(Boolean);

        if (
            normalized.length === 0
        ) {

            throw new Error(
                "Alice Blue contract master returned no usable contracts."
            );

        }

		const REQUIRED_INDEX_SYMBOLS =
			["NIFTY", "BANKNIFTY", "SENSEX"];

        //--------------------------------------------------
        // Detection uses the SAME robust helpers as
        // matchRank()/getAliceBlueContractBySymbol() -
        // isIndexContract() (text-based: checks symbol,
        // tradingSymbol, formattedName, instrumentType,
        // exchangeSegment, and the raw payload for INDEX/
        // IDX/the symbol name itself) plus
        // extractUnderlying() to confirm which index it is.
        // This does NOT require an exact instrumentType
        // === "INDEX" tag, unlike the old check - so a
        // genuinely present index row is correctly counted
        // as present even when AliceBlue leaves
        // instrument_type blank/other for it.
        //--------------------------------------------------

        const missingIndices =
            REQUIRED_INDEX_SYMBOLS.filter(sym =>
                !normalized.some(c =>
                    isIndexContract(c) &&
                    extractUnderlying(c) === sym
                )
            );

        if (missingIndices.length > 0 && loaded) {

            // A previous successful load exists in memory and
            // this fresh download is missing one or more core
            // indices that a correct download always has
            // (confirmed via the same detection logic used for
            // search/resolve elsewhere in this file). Rather
            // than silently overwrite good data with an
            // incomplete set - which is what happens during a
            // partial network outage or a flaky upstream
            // response for one exchange - skip this commit
            // entirely and keep serving the last known-good
            // contracts array. The next scheduled refresh will
            // retry.
			
            console.warn(
                "[ALICEBLUE SYMBOLS] Fresh download is missing expected index(es):",
                missingIndices,
                "- keeping previous in-memory contract set instead of overwriting."
            );

            return {
                success: false,
                skipped: true,
                missingIndices,
                count: contracts.length
            };
        }

        if (missingIndices.length > 0) {

            // No previous good data to fall back to (first
            // startup) - commit what we have anyway, since
            // partial data beats none, but log clearly so it's
            // visible in the startup log rather than silently
            // missing.
            console.warn(
                "[ALICEBLUE SYMBOLS] Initial download is missing expected index(es):",
                missingIndices,
                "- committing anyway (no previous data to fall back to)."
            );
        }

        contracts =
            normalized;

        buildIndexes();

        fs.writeFileSync(
            MASTER_FILE,
            JSON.stringify(
                {
                    provider: "ALICEBLUE",
                    downloadedAt:
                        new Date().toISOString(),
                    count:
                        contracts.length,
                    contracts
                },
                null,
                2
            ),
            "utf8"
        );

        loaded = true;

        lastRefresh =
            Date.now();

        const reliance =
            getAliceBlueContractBySymbol(
                "RELIANCE",
                "NSE"
            );

        const niftyCheck =
            getAliceBlueContractBySymbol(
                "NIFTY",
                "NSE"
            );

        return {

            success: true,

            count:
                contracts.length,

            file:
                MASTER_FILE,

            downloadedAt:
                new Date(
                    lastRefresh
                ).toISOString()

        };

    }
    catch (error) {

        console.error(
            "[ALICEBLUE SYMBOLS] Contract master download failed:",
            error?.message ??
            error
        );

        throw error;

    }

}

//======================================================
// LOAD LOCAL CACHE
//======================================================

export function loadContractMaster() {

    ensureDataDirectory();

    if (
        !fs.existsSync(
            MASTER_FILE
        )
    ) {

        return false;

    }

    try {

        const text =
            fs.readFileSync(
                MASTER_FILE,
                "utf8"
            );

        const parsed =
            JSON.parse(
                text
            );

        const cachedContracts =
            Array.isArray(
                parsed
                    ?.contracts
            )
                ? parsed.contracts
                : Array.isArray(
                    parsed
                )
                    ? parsed
                    : [];

        //--------------------------------------------------
        // IMPORTANT: contract-master.json already stores
        // NORMALIZED contracts (written by
        // downloadContractMaster() after normalizeContract()
        // already ran once). Running normalizeContract()
        // again here — treating already-normalized objects
        // as if they were fresh raw AliceBlue payloads —
        // double-normalizes them: each restart nests another
        // nowdead "raw" layer and silently degrades fields
        // like formattedName (e.g. "NIFTY 50" -> "NIFTY").
        // Use the cached objects directly instead.
        //--------------------------------------------------

        const normalized =
            cachedContracts.filter(
                contract =>
                    contract &&
                    typeof contract === "object" &&
                    (
                        contract.token ||
                        contract.tradingSymbol
                    )
            );

        if (
            normalized.length === 0
        ) {

            return false;

        }

        contracts =
            normalized;

        buildIndexes();

        loaded = true;

        lastRefresh =
            parsed?.downloadedAt
                ? Date.parse(
                    parsed.downloadedAt
                ) || 0
                : 0;

        console.log(
            `[ALICEBLUE SYMBOLS] Loaded ${contracts.length} contracts from local cache.`
        );

        return true;

    }

    catch (error) {

        console.error(
            "[ALICEBLUE SYMBOLS] Local cache load failed:",
            error?.message ??
            error
        );

        return false;

    }

}

//======================================================
// INITIALIZE
//======================================================

export async function initializeAliceBlueSymbols(
    options = {}
) {

    const {

        forceRefresh =
            false,

        downloadIfMissing =
            true

    } = options;

    const localLoaded =
        loadContractMaster();

    const stale =
        !lastRefresh ||
        (
            Date.now() -
            lastRefresh
        ) >
        REFRESH_INTERVAL_MS;

    if (
        forceRefresh ||
        (
            !localLoaded &&
            downloadIfMissing
        ) ||
        (
            localLoaded &&
            stale
        )
    ) {

        try {

            await downloadContractMaster();

        }

        catch (error) {

            if (
                localLoaded
            ) {

                console.warn(
                    "[ALICEBLUE SYMBOLS] Refresh failed. Continuing with local cache."
                );

            }
            else {

                throw error;

            }

        }

    }

    return {

        loaded,

        count:
            contracts.length,

        lastRefresh

    };

}

//======================================================
// AUTO REFRESH
//======================================================

export function startSymbolRefresh() {

    if (
        refreshTimer
    ) {

        return;

    }

    refreshTimer =
        setInterval(
            async () => {

                try {

                    await downloadContractMaster();

                }

                catch (
                    error
                ) {

                    console.error(
                        "[ALICEBLUE SYMBOLS] Scheduled refresh failed:",
                        error?.message ??
                        error
                    );

                }

            },
            REFRESH_INTERVAL_MS
        );

    if (
        refreshTimer.unref
    ) {

        refreshTimer.unref();

    }

    console.log(
        `[ALICEBLUE SYMBOLS] Auto refresh enabled every ${Math.round(
            REFRESH_INTERVAL_MS / 60000
        )} minutes.`
    );

}

//======================================================
// STOP REFRESH
//======================================================

export function stopSymbolRefresh() {

    if (
        refreshTimer
    ) {

        clearInterval(
            refreshTimer
        );

        refreshTimer =
            null;

    }

}

//======================================================
// GET ALL
//======================================================

export function getAllAliceBlueSymbols() {

    return [
        ...contracts
    ];

}

//======================================================
// COUNT
//======================================================

export function aliceBlueSymbolCount() {

    return contracts.length;

}

//======================================================
// SEARCH
//======================================================

export function searchAliceBlueSymbols(
    query = "",
    limit = 50,
    options = {}
) {

    const text =
        normalizeSymbol(
            query
        );

    const max =
        Math.min(
            Math.max(
                Number(
                    limit
                ) || 50,
                1
            ),
            500
        );

    const exchange =
        normalizeExchange(
            options.exchange
        );

    //--------------------------------------------------
    // EMPTY SEARCH
    //--------------------------------------------------

    if (
        !text
    ) {

        return contracts
            .filter(
                contract =>
                    !exchange ||
                    contract.exchange === exchange
            )
            .slice(
                0,
                max
            );

    }

    //--------------------------------------------------
    // TOKEN SEARCH
    //--------------------------------------------------

    if (
        /^\d+$/.test(
            text
        )
    ) {

        const tokenMatches =
            contracts.filter(
                contract =>

                    contract.token ===
                    text &&

                    (
                        !exchange ||
                        contract.exchange ===
                        exchange
                    )
            );

        if (
            tokenMatches.length
        ) {

            return tokenMatches
                .slice(
                    0,
                    max
                );

        }

    }

    //--------------------------------------------------
    // NORMAL SYMBOL SEARCH
    //
    // Ranked:
    //   -1  index contract whose underlying matches the
    //       query exactly (e.g. query "NIFTY" against the
    //       NIFTY 50 index itself) - always wins, even if
    //       AliceBlue's raw tradingSymbol for the index
    //       isn't a clean exact-match string (it's often
    //       "NIFTY 50", "NIFTY-EQ", etc. depending on the
    //       broker feed, not a bare "NIFTY"). This uses the
    //       same isIndexContract()/extractUnderlying()
    //       helpers already used elsewhere in this file, so
    //       it doesn't depend on exact string equality.
    //    0  exact match on tradingSymbol/symbol/formattedName
    //    1  starts with the query
    //    2  contains the query anywhere
    //
    // Without the -1 tier, an index like NIFTY was getting
    // buried behind every NIFTY option/future contract
    // whenever its raw trading symbol wasn't a bare exact
    // match for the typed query.
    //--------------------------------------------------

	function matchRank(contract) {
	
		// Real index rows only (exchangeSegment = nse_idx / bse_idx / etc,
		// or instrumentType === "INDEX") - never true for options/futures,
		// unlike isIndexContract() which matches on substring text.
		const seg = String(contract.exchangeSegment ?? "").toUpperCase();
		const type = String(contract.instrumentType ?? "").toUpperCase();
		if (
			type === "INDEX" ||
			seg.includes("IDX") ||
			seg.includes("INDEX")
		) {
			if (extractUnderlying(contract) === text) {
				return -2;
			}
		}
	
		if (
			isIndexContract(contract) &&
			extractUnderlying(contract) === text
		) {
			return -1;
		}
	
		if (
			contract.tradingSymbol === text ||
			contract.symbol === text ||
			contract.formattedName === text
		) {
			return 0;
		}
	
		if (
			contract.tradingSymbol.startsWith(text) ||
			contract.symbol.startsWith(text) ||
			contract.formattedName.startsWith(text)
		) {
			return 1;
		}
	
		return 2;
	}

    const results =
        contracts.filter(
            contract => {

                if (
                    exchange &&
                    contract.exchange !==
                    exchange
                ) {

                    return false;

                }

                return (

                    contract.tradingSymbol
                        .includes(
                            text
                        )

                    ||

                    contract.symbol
                        .includes(
                            text
                        )

                    ||

                    contract.formattedName
                        .includes(
                            text
                        )

                );

            }
        );

    return results
        .sort((a, b) => {

            const rankDiff = matchRank(a) - matchRank(b);

            if (rankDiff !== 0) {
                return rankDiff;
            }

            return a.symbol.length - b.symbol.length;
        })
        .slice(
            0,
            max
        );

}

//======================================================
// OPTION SEARCH
//
// Examples:
//
// searchAliceBlueOptions({
//     underlying: "NIFTY",
//     strike: 24500,
//     optionType: "CE"
// })
//
// searchAliceBlueOptions({
//     underlying: "NIFTY",
//     strike: 24500
// })
//====================================================== 
 
export function searchAliceBlueOptions(options = {}) { 
    const { 
        underlying = "", 
        expiry = "", 
        strike, 
        optionType = "", 
        exchange = "NFO", 
        limit = 100 
    } = options; 
 
    const wantedUnderlying = normalizeSymbol(underlying); 
    const wantedExpiry = normalizeExpiry(expiry); 
    const wantedStrike = 
        strike === undefined || strike === null || String(strike).trim() === "" 
            ? undefined 
            : Number(strike); 
    const wantedType = normalizeSymbol(optionType); 
    const wantedExchange = normalizeExchange(exchange); 
 
    const max = Math.min(Math.max(Number(limit) || 100, 1), 500); 
 
    const results = contracts.filter((contract) => { 
        if (wantedExchange && normalizeExchange(contract.exchange) !== wantedExchange) { 
            return false; 
        } 
 
        if ( 
            wantedUnderlying && 
            normalizeSymbol(contract.symbol) !== wantedUnderlying 
        ) { 
            return false; 
        } 
 
        if ( 
            wantedExpiry && 
            normalizeExpiry(contract.expiry) !== wantedExpiry 
        ) { 
            return false; 
        } 
 
        if ( 
            wantedStrike !== undefined && 
            Number(contract.strike) !== wantedStrike 
        ) { 
            return false; 
        } 
 
        if ( 
            wantedType && 
            normalizeSymbol(contract.optionType) !== wantedType 
        ) { 
            return false; 
        } 
 
        const instrumentType = normalizeSymbol(contract.instrumentType); 
 
        return ( 
            instrumentType === "OPTSTK" || 
            instrumentType === "OPTIDX" || 
            instrumentType === "SO" ||
            instrumentType === "IO" ||
            instrumentType.includes("OPT") 
        ); 
    }); 
 
    return results 
        .sort( 
            (a, b) => 
                String(a.expiry ?? "").localeCompare(String(b.expiry ?? "")) || 
                Number(a.strike ?? 0) - Number(b.strike ?? 0) || 
                String(a.optionType ?? "").localeCompare( 
                    String(b.optionType ?? "") 
                ) || 
                String(a.tradingSymbol ?? "").localeCompare( 
                    String(b.tradingSymbol ?? "") 
                ) 
        ) 
        .slice(0, max); 
} 
 
//====================================================== 
// STRIKE SEARCH
//
// Example:
//
// searchAliceBlueStrike("24500", "NIFTY")
//======================================================

export function searchAliceBlueStrike(
    strike,
    underlying = "",
    limit = 100
) {

    const numericStrike =
        Number(
            strike
        );

    if (
        !Number.isFinite(
            numericStrike
        )
    ) {

        return [];

    }

    const wantedUnderlying =
        normalizeSymbol(
            underlying
        );

    const result =
        contracts.filter(
            contract => {

                if (
                    contract.exchange !== "NFO" &&
                    contract.exchange !== "BFO"
                ) {

                    return false;

                }

                if (
                    Number(
                        contract.strike
                    ) !==
                    numericStrike
                ) {

                    return false;

                }

                if (
                    wantedUnderlying
                ) {

                    if (
                        extractUnderlying(
                            contract
                        ) !==
                        wantedUnderlying
                    ) {

                        return false;

                    }

                }

                return true;

            }
        );

    return result
        .slice(
            0,
            Math.min(
                Number(
                    limit
                ) || 100,
                500
            )
        );

}

//======================================================
// TOKEN -> CONTRACT
//======================================================

export function getAliceBlueContractByToken(
    exchange,
    token
) {

    const key =
        `${normalizeExchange(exchange)}|${stringValue(token)}`;

    return (
        tokenIndex.get(
            key
        ) ??
        null
    );

}

//======================================================
// SYMBOL -> CONTRACT
//======================================================


export function getAliceBlueContractBySymbol(symbol, exchange = "") {

    if (!loaded || !Array.isArray(contracts)) {
        return null;
    }

    let wanted =
        String(symbol ?? "")
            .trim()
            .toUpperCase();

    const wantedExchange =
        String(exchange ?? "")
            .trim()
            .toUpperCase();

    if (!wanted) {
        return null;
    }

    // Frontend symbol normalization
    wanted =
        wanted
            .replace(/^(NSE:|BSE:)/, "")
            .replace(/^(NSE\||BSE\|)/, "")
            .replace(/-NSE$/, "")
            .replace(/-BSE$/, "")
            .replace(/-EQ$/, "")
            .replace(/-BE$/, "")
            .replace(/-SM$/, "");

    if (wanted === "RELIACNE") {
        wanted = "RELIANCE";
    }

    function clean(value) {
        return String(value ?? "")
            .trim()
            .toUpperCase();
    }

    function contractExchange(contract) {
        return clean(
            contract?.exchange ??
            contract?.exch ??
            contract?.raw?.exchange ??
            contract?.raw?.exch
        );
    }

    function contractSymbol(contract) {
        return clean(
            contract?.symbol ??
            contract?.raw?.symbol ??
            contract?.formattedName ??
            contract?.raw?.formatted_ins_name
        );
    }

    function contractTradingSymbol(contract) {
        return clean(
            contract?.tradingSymbol ??
            contract?.trading_symbol ??
            contract?.raw?.tradingSymbol ??
            contract?.raw?.trading_symbol ??
            contract?.formattedName ??
            contract?.raw?.formatted_ins_name
        );
    }

    function matches(contract) {

        const ex =
            contractExchange(contract);

        const sym =
            contractSymbol(contract);

        const ts =
            contractTradingSymbol(contract);

        const formatted =
            clean(
                contract?.formattedName ??
                contract?.raw?.formatted_ins_name
            );

        if (
            wantedExchange &&
            ex !== wantedExchange
        ) {
            return false;
        }

        // Exact match against every common Alice Blue
        // representation.
        if (sym === wanted) {
            return true;
        }

        if (ts === wanted) {
            return true;
        }

        if (formatted === wanted) {
            return true;
        }

        if (ts === wanted + "-EQ") {
            return true;
        }

        if (ts === wanted + "-BE") {
            return true;
        }

        if (ts === wanted + "-SM") {
            return true;
        }

        // Allow underlying-based match for indices, so
        // "NIFTY" resolves to the index contract even when
        // its raw tradingSymbol/symbol/formattedName is
        // something like "NIFTY 50" rather than a bare
        // "NIFTY" string.
        //
        // IMPORTANT: must use the STRICT real-index check
        // (exchangeSegment/instrumentType based), not the
        // loose text-based isIndexContract(). isIndexContract()
        // matches any contract whose symbol merely CONTAINS
        // "SENSEX"/"NIFTY" etc - which is true for every
        // option and future on that underlying too. Using it
        // here let this branch match thousands of derivative
        // contracts, and getAliceBlueContractBySymbol("SENSEX")
        // could return a random SENSEX option/future instead
        // of the real index depending on array order.

        const seg =
            clean(contract.exchangeSegment);

        const type =
            clean(contract.instrumentType);

        const isRealIndexRow =
            type === "INDEX" ||
            seg.includes("IDX") ||
            seg.includes("INDEX");

        if (
            isRealIndexRow &&
            extractUnderlying(contract) === wanted
        ) {
            return true;
        }

        return false;
    }

        //==================================================
        // INDEX FIRST
        //==================================================

        for (const contract of contracts) {

                if (!matches(contract)) {
                        continue;
                }

                if (!isIndexContract(contract)) {
                        continue;
                }

                // Prefer actual index segments.
                const segment =
                        clean(contract.exchangeSegment);

                const instrumentType =
                        clean(contract.instrumentType);

                if (
                        segment.includes("IDX") ||
                        segment.includes("INDEX") ||
                        instrumentType.includes("INDEX") ||
                        instrumentType === "INDEX"
                ) {
                        return contract;
                }
        }

        // Fallback: if Alice Blue's contract master does not
        // populate exchangeSegment/instrumentType correctly,
        // still allow the identified index contract.
        for (const contract of contracts) {

                if (
                        matches(contract) &&
                        isIndexContract(contract)
                ) {
                        return contract;
                }
        }

    //==================================================
    // NSE CASH / EQUITY
    //==================================================

    for (const contract of contracts) {

        if (!matches(contract)) {
            continue;
        }

        if (
            wantedExchange === "NSE" &&
            clean(contract.exchangeSegment) === "NSE_CM" &&
            (
                clean(contract.instrumentType) === "0" ||
                clean(contract.groupName) === "EQ"
            )
        ) {
            return contract;
        }
    }

    //==================================================
    // NORMAL EXACT MATCH
    //==================================================

    for (const contract of contracts) {

        if (matches(contract)) {
            return contract;
        }
    }

    return null;
}

//======================================================
// SYMBOL -> CONTRACT METADATA
//======================================================

export function getAliceBlueInstrumentInfo(
    symbol,
    exchange = ""
) {

    const contract =
        getAliceBlueContractBySymbol(
            symbol,
            exchange
        );

    if (!contract) {
        return null;
    }

    const text = [
        contract?.symbol,
        contract?.tradingSymbol,
        contract?.formattedName,
        contract?.instrumentType,
        contract?.groupName,
        contract?.exchangeSegment,
        contract?.raw?.symbol,
        contract?.raw?.trading_symbol,
        contract?.raw?.formatted_ins_name,
        contract?.raw?.instrument_type,
        contract?.raw?.exchange_segment
    ]
        .map(
            value =>
                String(
                    value ?? ""
                )
                    .trim()
                    .toUpperCase()
        )
        .join(" ");

    const isIndex =
        text.includes("INDEX") ||
        text.includes("IDX") ||
        text.includes("NIFTY") ||
        text.includes("BANKNIFTY") ||
        text.includes("FINNIFTY") ||
        text.includes("MIDCPNIFTY") ||
        text.includes("SENSEX") ||
        text.includes("BANKEX");

    return {
        exchange:
            contract.exchange,

        token:
            contract.token,

        symbol:
            contract.symbol,

        tradingSymbol:
            contract.tradingSymbol,

        exchangeSegment:
            contract.exchangeSegment,

        instrumentType:
            contract.instrumentType,

        isIndex
    };
}

//======================================================
// RESOLVE SYMBOL -> TOKEN
//======================================================

export function resolveAliceBlueToken(
    exchange,
    symbol
) {

    const contract =
        getAliceBlueContractBySymbol(
            symbol,
            exchange
        );

    return contract
        ?.token ??
        null;

}

//======================================================
// SEARCH FOR FRONTEND
//
// Converts internal contract format into the common
// AJ Institutional symbol-search response.
//======================================================

export function searchAliceBlueSymbolsForUI(
    query = "",
    limit = 50
) {

    const text =
        normalizeSymbol(
            query
        );

    //--------------------------------------------------
    // OPTION STRIKE SEARCH
    //--------------------------------------------------

    const strikeMatch =
        text.match(
            /(\d+(?:\.\d+)?)/
        );

    const hasCE =
        /\bCE\b/.test(
            text
        );

    const hasPE =
        /\bPE\b/.test(
            text
        );

    const optionUnderlying =
        /\b(NIFTY|BANKNIFTY|FINNIFTY|MIDCPNIFTY|SENSEX|BANKEX)\b/
            .exec(
                text
            )?.[1] ?? "";

    if (
        strikeMatch &&
        (
            hasCE ||
            hasPE ||
            optionUnderlying
        )
    ) {

        const strike =
            Number(
                strikeMatch[1]
            );

        let optionResults =
            searchAliceBlueStrike(
                strike,
                optionUnderlying,
                limit
            );

        if (
            hasCE
        ) {

            optionResults =
                optionResults.filter(
                    contract =>
                        normalizeSymbol(
                            contract.optionType
                        ) === "CE"
                );

        }

        if (
            hasPE
        ) {

            optionResults =
                optionResults.filter(
                    contract =>
                        normalizeSymbol(
                            contract.optionType
                        ) === "PE"
                );

        }

        return optionResults.map(
            toUISymbol
        );

    }

    //--------------------------------------------------
    // PURE NUMERIC SEARCH
    //
    // 24500
    //
    // Return option contracts around that strike.
    //--------------------------------------------------

    if (
        /^\d+(?:\.\d+)?$/.test(
            text
        )
    ) {

        return searchAliceBlueStrike(
            Number(
                text
            ),
            "",
            limit
        ).map(
            toUISymbol
        );

    }

    //--------------------------------------------------
    // NORMAL SEARCH
    //--------------------------------------------------

    return searchAliceBlueSymbols(
        text,
        limit
    ).map(
        toUISymbol
    );

}

//======================================================
// UI FORMAT
//======================================================

//--------------------------------------------------
// DISPLAY SYMBOL
//
// Strips AliceBlue's internal segment suffixes
// (-EQ / -BE / -SM) so the frontend shows "RELIANCE"
// instead of "RELIANCE-EQ". The full tradingSymbol is
// still returned separately and is what actually gets
// sent back to resolveAliceBlueToken() / getHistory() -
// this only cleans up what the user SEES, it doesn't
// change what gets resolved internally.
//--------------------------------------------------

function toDisplaySymbol(value) {

    return String(value ?? "")
        .trim()
        .toUpperCase()
        .replace(/-EQ$/, "")
        .replace(/-BE$/, "")
        .replace(/-SM$/, "");
}

function toUISymbol(
    contract
) {

    const rawSymbol =
        contract.tradingSymbol ||
        contract.symbol;

    const rawDisplayName =
        contract.formattedName ||
        contract.tradingSymbol ||
        contract.symbol;

    return {

        symbol:
            toDisplaySymbol(rawSymbol),

        tradingSymbol:
            contract.tradingSymbol,

        displayName:
            toDisplaySymbol(rawDisplayName),

        exchange:
            contract.exchange,

        exchangeSegment:
            contract.exchangeSegment,

        type:
            contract.optionType
                ? "OPTION"
                : isIndexContract(contract)
                    ? "INDEX"
                    : "EQUITY",

        feedSource:
            "ALICEBLUE",

        token:
            contract.token,

        tokenIdentifier:
            contract.token,

        instrumentId:
            contract.token,

        expiry:
            contract.expiry,

        strike:
            contract.strike,

        optionType:
            contract.optionType,

        underlying:
            extractUnderlying(
                contract
            ),

        lotSize:
            contract.lotSize,

        tickSize:
            contract.tickSize

    };

}

//======================================================
// STATUS
//======================================================

export function getAliceBlueSymbolStatus() {

    return {

        loaded,

        count:
            contracts.length,

        lastRefresh:
            lastRefresh
                ? new Date(
                    lastRefresh
                ).toISOString()
                : null,

        cacheFile:
            MASTER_FILE,

        refreshIntervalMs:
            REFRESH_INTERVAL_MS

    };

}

//======================================================
// SHUTDOWN
//======================================================

export function shutdownAliceBlueSymbols() {

    stopSymbolRefresh();

    contracts =
        [];

    clearIndexes();

    loaded =
        false;

}

//======================================================
// NAMED EXPORTS (for equitySearchRoute.js debug endpoint)
//======================================================

export { isIndexContract, extractUnderlying };

//======================================================
// DEFAULT EXPORT
//======================================================

export default {

    initializeAliceBlueSymbols,

    downloadContractMaster,

    loadContractMaster,

    startSymbolRefresh,

    stopSymbolRefresh,

    searchAliceBlueSymbols,

    searchAliceBlueSymbolsForUI,

    searchAliceBlueOptions,

    searchAliceBlueStrike,

    getAliceBlueContractByToken,

    getAliceBlueContractBySymbol,

    resolveAliceBlueToken,

    getAliceBlueInstrumentInfo,

    getAllAliceBlueSymbols,

    aliceBlueSymbolCount,

    getAliceBlueSymbolStatus,

    shutdownAliceBlueSymbols

};
