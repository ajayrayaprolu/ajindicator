//==============================
// ./tsconfig.server.json
//==============================

{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["server/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.js"
  ]
}